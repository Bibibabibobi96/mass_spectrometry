*.json text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.m text eol=lf
*.lua text eol=lf
*.gem text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.md text eol=lf
.githooks/pre-commit text eol=lf
# History is immutable payload. Preserve its exact Git bytes on every OS so
# frozen SHA-256 lists remain valid after directory renames and clean checkout.
# Root-history TXT uses the history bytes/SHA contract to verify original bytes.
docs/history/*/*.txt -text -eol -whitespace
projects/*/docs/history/** -text -eol
integrations/*/docs/history/** -text -eol
integrations/docs/history/** -text -eol
# Entry indexes remain editable guidance; frozen records below them keep -text.
projects/*/docs/history/README.md text eol=lf
integrations/docs/history/README.md text eol=lf
