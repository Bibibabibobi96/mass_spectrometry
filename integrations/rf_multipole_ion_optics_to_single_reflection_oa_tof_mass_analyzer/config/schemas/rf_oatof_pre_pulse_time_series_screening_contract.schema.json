{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_oatof_pre_pulse_time_series_screening_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "mode", "active_scope", "claim_limit",
    "identities", "rf_time_grid", "pulse_disabled", "resolution_claim_allowed",
    "prohibited_outputs"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4, 5, 6, 7]},
    "role": {"const": "rf_oatof_pre_pulse_time_series_screening_contract"},
    "mode": {"const": "real_pa_rf_pre_pulse_time_series"},
    "active_scope": {"const": "pre_pulse_frontend_accelerator"},
    "claim_limit": {"const": "FUNCTIONAL_ONLY"},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id", "experiment_id", "experiment_row_sha256",
        "connection_profile_id", "source_profile_id",
        "resolved_source_contract_sha256", "resolved_population_contract_sha256",
        "mother_particle_source_sha256", "ordered_particle_id_sha256",
        "layout_profile_id", "architecture_generation_id", "topology_id",
        "geometry_id", "frontend_electrode_topology_id", "field_id",
        "field_profile_id", "region_field_semantic_sha256",
        "frontend_grid_profile_id", "field_overlay_id",
        "oatof_numerical_profile_id", "trajectory_quality_profile_id",
        "time_integration_profile_id", "spatial_window_profile_id"
      ],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/id"},
        "experiment_id": {"$ref": "#/$defs/id"},
        "experiment_row_sha256": {"$ref": "#/$defs/sha"},
        "connection_profile_id": {"$ref": "#/$defs/id"},
        "source_profile_id": {"$ref": "#/$defs/id"},
        "resolved_source_contract_sha256": {"$ref": "#/$defs/sha"},
        "resolved_population_contract_sha256": {"$ref": "#/$defs/sha"},
        "mother_particle_source_sha256": {"$ref": "#/$defs/sha"},
        "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"},
        "layout_profile_id": {"$ref": "#/$defs/id"},
        "architecture_generation_id": {"$ref": "#/$defs/id"},
        "candidate_sha256": {"$ref": "#/$defs/sha"},
        "topology_id": {"$ref": "#/$defs/id"},
        "geometry_id": {"$ref": "#/$defs/id"},
        "frontend_electrode_topology_id": {"$ref": "#/$defs/id"},
        "field_id": {"$ref": "#/$defs/id"},
        "field_profile_id": {"$ref": "#/$defs/id"},
        "region_field_semantic_sha256": {"$ref": "#/$defs/sha"},
        "frontend_grid_profile_id": {"$ref": "#/$defs/id"},
        "field_overlay_id": {"$ref": "#/$defs/id"},
        "oatof_numerical_profile_id": {"$ref": "#/$defs/id"},
        "trajectory_quality_profile_id": {"$ref": "#/$defs/id"},
        "time_integration_profile_id": {"$ref": "#/$defs/id"},
        "spatial_window_profile_id": {"$ref": "#/$defs/id"}
      }
    },
    "pa_cache_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "accelerator_overlay", "flight_tube", "reflectron"],
      "properties": {
        "frontend": {"$ref": "#/$defs/sha"},
        "accelerator_overlay": {"$ref": "#/$defs/sha"},
        "flight_tube": {"type": "null"},
        "reflectron": {"type": "null"}
      }
    },
    "pa_cache_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_source", "required", "prohibited"],
      "properties": {
        "identity_source": {"const": "runner_materialized_verified_pa_cache_receipt"},
        "required": {
          "oneOf": [
            {"const": ["frontend", "accelerator_overlay"]},
            {"const": ["frontend", "accelerator_entrance_overlay", "accelerator_intermediate_overlay"]},
            {"const": ["full_coarse_bridge", "fine_upstream", "accelerator_main", "accelerator_intermediate2_overlay"]},
            {"const": ["fine_upstream", "accelerator_entrance_zone_collision"]}
          ]
        },
        "prohibited": {"const": ["flight_tube", "reflectron"]}
      }
    },
    "rf_time_grid": {
      "oneOf": [
        {"$ref": "#/$defs/rf_time_grid_v1"},
        {"$ref": "#/$defs/rf_time_grid_v2"},
        {"$ref": "#/$defs/rf_time_grid_v3"},
        {"$ref": "#/$defs/rf_time_grid_v4"}
      ]
    },
    "sample_times_us": {
      "type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}
    },
    "selection_order": {"const": ["maximize_pulse_eligible_count", "maximize_transverse_bore_count", "minimize_normalized_xyz_centroid_distance", "minimize_normalized_xyz_spread_norm", "minimize_absolute_distance_to_ballistic_seed", "select_earlier_time"]},
    "pulse_disabled": {"const": true},
    "terminate_at_window_end": {"type": "boolean"},
    "trace_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "terminal_event", "retention_class"],
      "properties": {
        "mode": {"const": "natural_trajectory_native_rf_grid_v1"},
        "terminal_event": {"const": "geometry_collision_v1"},
        "retention_class": {"const": "rebuildable_trajectory_payload"}
      }
    },
    "resolution_claim_allowed": {"const": false},
    "prohibited_outputs": {"const": ["detector_crossing", "resolution_metrics", "single_flight_spatial_six_panel"]}
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {"const": 1},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v1"},
        "identities": {
          "properties": {
            "spatial_window_profile_id": {
              "const": "layout_resolved_axial_provisional_xy2_v1"
            }
          }
        },
        "pa_cache_roles": {
          "properties": {
            "required": {"const": ["frontend", "accelerator_overlay"]}
          }
        }
      },
      "required": ["pa_cache_keys"],
      "not": {"required": ["pa_cache_roles"]}
    },
    {
      "properties": {
        "schema_version": {"const": 2},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v2"},
        "identities": {
          "properties": {
            "spatial_window_profile_id": {
              "const": "layout_resolved_axial_provisional_xy2_v1"
            }
          }
        }
      },
      "required": ["pa_cache_roles"],
      "not": {"required": ["pa_cache_keys"]}
    },
    {
      "properties": {
        "schema_version": {"const": 3},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v2"},
        "identities": {
          "properties": {
            "spatial_window_profile_id": {
              "const": "layout_resolved_axial_provisional_xy2_v1"
            }
          }
        },
        "pa_cache_roles": {
          "properties": {
            "required": {
              "const": ["frontend", "accelerator_entrance_overlay", "accelerator_intermediate_overlay"]
            }
          }
        }
      },
      "required": ["pa_cache_roles"],
      "not": {"required": ["pa_cache_keys"]}
    },
    {
      "properties": {
        "schema_version": {"const": 4},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v2"},
        "identities": {"properties": {"spatial_window_profile_id": {"const": "layout_resolved_axial_provisional_xy2_v1"}}},
        "pa_cache_roles": {"properties": {"required": {"const": ["full_coarse_bridge", "fine_upstream", "accelerator_main", "accelerator_intermediate2_overlay"]}}}
      },
      "required": ["pa_cache_roles"],
      "not": {"required": ["pa_cache_keys"]}
    },
    {
      "properties": {
        "schema_version": {"const": 5},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v2"},
        "identities": {"properties": {"spatial_window_profile_id": {"const": "layout_resolved_axial_provisional_xy2_v1"}}},
        "pa_cache_roles": {"properties": {"required": {"const": ["fine_upstream", "accelerator_entrance_zone_collision"]}}}
      },
      "required": ["pa_cache_roles"],
      "not": {"required": ["pa_cache_keys"]}
    },
    {
      "properties": {
        "schema_version": {"const": 6},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v3"},
        "identities": {"properties": {"spatial_window_profile_id": {"const": "layout_resolved_axial_provisional_xy2_v1"}}},
        "pa_cache_roles": {"properties": {"required": {"const": ["fine_upstream", "accelerator_entrance_zone_collision"]}}}
      },
      "required": ["pa_cache_roles"],
      "not": {"required": ["pa_cache_keys"]}
    },
    {
      "properties": {
        "schema_version": {"const": 7},
        "rf_time_grid": {"$ref": "#/$defs/rf_time_grid_v4"},
        "pa_cache_roles": {"properties": {"required": {"const": ["fine_upstream", "accelerator_entrance_zone_collision"]}}},
        "terminate_at_window_end": {"const": false}
      },
      "required": ["pa_cache_roles", "trace_policy", "terminate_at_window_end"],
      "not": {"required": ["pa_cache_keys", "sample_times_us"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "rf_time_grid_v1": {
      "type": "object", "additionalProperties": false,
      "required": ["derivation", "waveform", "frequency_hz", "phase_rad", "rf_steps_per_period", "period_us", "step_us", "anchor_time_us", "grid_origin_us", "requested_relative_start_index", "requested_relative_end_index", "anchor_sample_index", "start_index", "end_index", "sample_count"],
      "properties": {
        "derivation": {"const": "grid_origin_us + sample_index*period_us/rf_steps_per_period"},
        "waveform": {"enum": ["sine", "cosine"]},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "phase_rad": {"type": "number"},
        "rf_steps_per_period": {"type": "integer", "minimum": 1},
        "period_us": {"type": "number", "exclusiveMinimum": 0},
        "step_us": {"type": "number", "exclusiveMinimum": 0},
        "sample_stride_rf_steps": {"type": "integer", "minimum": 1},
        "anchor_time_us": {"type": "number", "minimum": 0},
        "grid_origin_us": {"type": "number", "minimum": 0},
        "requested_relative_start_index": {"type": "integer"},
        "requested_relative_end_index": {"type": "integer"},
        "anchor_sample_index": {"type": "integer", "minimum": 0},
        "start_index": {"const": 0},
        "end_index": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "rf_time_grid_v2": {
      "type": "object", "additionalProperties": false,
      "required": ["time_grid_profile_id", "derivation", "waveform", "frequency_hz", "phase_rad", "rf_steps_per_period", "period_us", "step_us", "ballistic_seed_time_us", "grid_origin_us", "requested_relative_start_index", "requested_relative_end_index", "ballistic_seed_sample_index", "start_index", "end_index", "sample_count"],
      "properties": {
        "time_grid_profile_id": {"$ref": "#/$defs/id"},
        "derivation": {"const": "ballistic_seed_time_us + relative_index*period_us/rf_steps_per_period"},
        "waveform": {"enum": ["sine", "cosine"]},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "phase_rad": {"type": "number"},
        "rf_steps_per_period": {"type": "integer", "minimum": 1},
        "period_us": {"type": "number", "exclusiveMinimum": 0},
        "step_us": {"type": "number", "exclusiveMinimum": 0},
        "sample_stride_rf_steps": {"type": "integer", "minimum": 1},
        "ballistic_seed_time_us": {"type": "number", "minimum": 0},
        "grid_origin_us": {"type": "number", "minimum": 0},
        "requested_relative_start_index": {"type": "integer", "maximum": 0},
        "requested_relative_end_index": {"type": "integer"},
        "ballistic_seed_sample_index": {"type": "integer", "minimum": 0},
        "start_index": {"const": 0},
        "end_index": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "rf_time_grid_v3": {
      "type": "object", "additionalProperties": false,
      "required": ["time_grid_profile_id", "derivation", "waveform", "frequency_hz", "phase_rad", "rf_steps_per_period", "period_us", "step_us", "sample_stride_rf_steps", "source_state_table_sha256", "source_forward_particle_count", "source_ballistic_seed_time_us", "source_bore_entry_window_start_us", "source_bore_exit_window_end_us", "grid_origin_us", "requested_relative_start_index", "requested_relative_end_index", "start_index", "end_index", "sample_count"],
      "properties": {
        "time_grid_profile_id": {"const": "continuous_source_bore_crossing_native_rf_grid_v1"},
        "derivation": {"const": "source_population_forward_bore_crossing_bounds_v1"},
        "waveform": {"enum": ["sine", "cosine"]},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "phase_rad": {"type": "number"},
        "rf_steps_per_period": {"type": "integer", "minimum": 1},
        "period_us": {"type": "number", "exclusiveMinimum": 0},
        "step_us": {"type": "number", "exclusiveMinimum": 0},
        "sample_stride_rf_steps": {"const": 1},
        "source_state_table_sha256": {"$ref": "#/$defs/sha"},
        "source_forward_particle_count": {"type": "integer", "minimum": 1},
        "source_ballistic_seed_time_us": {"type": "number", "minimum": 0},
        "source_bore_entry_window_start_us": {"type": "number", "minimum": 0},
        "source_bore_exit_window_end_us": {"type": "number", "exclusiveMinimum": 0},
        "grid_origin_us": {"type": "number", "minimum": 0},
        "requested_relative_start_index": {"type": "integer"},
        "requested_relative_end_index": {"type": "integer"},
        "start_index": {"const": 0},
        "end_index": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "rf_time_grid_v4": {
      "type": "object", "additionalProperties": false,
      "required": ["time_grid_profile_id", "derivation", "waveform", "frequency_hz", "phase_rad", "rf_steps_per_period", "period_us", "step_us", "sample_stride_rf_steps", "grid_origin_us"],
      "properties": {
        "time_grid_profile_id": {"const": "natural_pre_pulse_native_rf_grid_v1"},
        "derivation": {"const": "native_rf_grid_from_instrument_clock_origin_v1"},
        "waveform": {"enum": ["sine", "cosine"]},
        "frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "phase_rad": {"type": "number"},
        "rf_steps_per_period": {"type": "integer", "minimum": 1},
        "period_us": {"type": "number", "exclusiveMinimum": 0},
        "step_us": {"type": "number", "exclusiveMinimum": 0},
        "sample_stride_rf_steps": {"const": 1},
        "grid_origin_us": {"type": "number", "minimum": 0}
      }
    }
  }
}
