{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign.schema.json",
  "allOf": [
    {
      "$ref": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign_v1_to_v6.schema.json"
    },
    {
      "properties": {
        "schema_version": {"const": 6}
      }
    },
    {
      "properties": {
        "experiments": {
          "type": "array",
          "items": {
            "not": {
              "anyOf": [
                {"required": ["single_flight_batch_count"]},
                {
                  "properties": {
                    "single_flight_batch_memory_policy": {
                      "anyOf": [
                        {"required": ["default_batch_count"]},
                        {"required": ["maximum_batch_count"]}
                      ]
                    }
                  },
                  "required": ["single_flight_batch_memory_policy"]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
