{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_resolved_experiment_campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "campaign_id", "status", "claim_limit", "experiments"],
  "properties": {
    "schema_version": {"const": 7},
    "role": {"const": "rf_multipole_oatof_experiment_campaign"},
    "integration_id": {"const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"},
    "campaign_id": {"$ref": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign_v1_to_v6.schema.json#/$defs/id"},
    "status": {"enum": ["authorized", "exploration"]},
    "execution_policy": {"$ref": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign_v1_to_v6.schema.json#/$defs/file"},
    "claim_limit": {"type": "string", "minLength": 1},
    "pre_pulse_time_series_screening": {"$ref": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign_v1_to_v6.schema.json#/$defs/pre_pulse_time_series_screening"},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign_v1_to_v6.schema.json#/$defs/experiment"},
          {
            "required": ["single_flight_layout_profile_id"],
            "not": {
              "anyOf": [
                {"required": ["single_flight_batch_count"]},
                {"required": ["single_flight_batch_memory_policy"]}
              ]
            },
            "allOf": [
              {
                "if": {
                  "required": ["execution_strategy"],
                  "properties": {"execution_strategy": {"const": "simion_single_flight"}}
                },
                "then": {"required": ["single_flight_pa_cache_policy"]}
              }
            ]
          }
        ]
      }
    }
  }
}
