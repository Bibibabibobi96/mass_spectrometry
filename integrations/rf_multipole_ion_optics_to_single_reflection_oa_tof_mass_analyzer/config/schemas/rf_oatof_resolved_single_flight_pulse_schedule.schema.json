{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_oatof_resolved_single_flight_pulse_schedule.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "campaign_id", "experiment_id",
    "experiment_row_sha256", "population_declaration_sha256", "policy",
    "rf_period_us", "pulse_base_time_us", "pulse_offset_us",
    "pulse_effective_time_us", "pulse_width_us"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "rf_oatof_resolved_single_flight_pulse_schedule"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "experiment_row_sha256": {"$ref": "#/$defs/sha"},
    "population_declaration_sha256": {"$ref": "#/$defs/sha"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "offset_rf_periods", "pulse_width_us"],
      "properties": {
        "policy_id": {"const": "multipole_handoff_ballistic_centroid_v1"},
        "offset_rf_periods": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "pulse_width_us": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "rf_period_us": {"type": "number", "exclusiveMinimum": 0},
    "pulse_base_time_us": {"type": "number", "minimum": 0},
    "pulse_offset_us": {"type": "number"},
    "pulse_effective_time_us": {"type": "number", "minimum": 0},
    "pulse_width_us": {"type": "number", "exclusiveMinimum": 0},
    "layout_profile_id": {"$ref": "#/$defs/id"},
    "method": {"type": "string", "minLength": 1},
    "source_state_path": {"type": "string", "minLength": 1},
    "source_state_sha256": {"$ref": "#/$defs/sha"},
    "population_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["transmitted_handoff", "predicted_finite_wall_survivors"],
      "properties": {
        "transmitted_handoff": {"type": "integer", "minimum": 1},
        "predicted_finite_wall_survivors": {"type": "integer", "minimum": 1}
      }
    },
    "selected_particle_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "mean_entry_time_us": {"type": "number"},
    "mean_velocity_x_m_s": {"type": "number", "exclusiveMinimum": 0},
    "mean_kinetic_energy_eV": {"type": "number", "exclusiveMinimum": 0},
    "target_centroid_x_mm": {"type": "number"},
    "entry_surface_x_mm": {"type": "number"},
    "base_predicted_centroid_error_x_mm": {"type": "number"},
    "predicted_centroid_error_x_mm": {"type": "number"},
    "claim_status": {"type": "string", "minLength": 1},
    "execution_authority": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "mode", "content_key", "candidate_parent_manifest",
            "candidate_selection_receipt", "selection_preregistered",
            "confirmation_selection_authorized", "confirmation_policy_id"
          ],
          "properties": {
            "mode": {"const": "detector_blind_candidate_confirmation_v1"},
            "content_key": {"$ref": "#/$defs/sha"},
            "candidate_parent_manifest": {"$ref": "#/$defs/file"},
            "candidate_selection_receipt": {"$ref": "#/$defs/file"},
            "selection_preregistered": {"type": "boolean"},
            "confirmation_selection_authorized": {"const": true},
            "confirmation_policy_id": {
              "const": "identical_identity_pulse_on_full_flight_v1"
            },
            "pilot_verified_receipt": {"$ref": "#/$defs/file"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "content_key", "verified_receipt"],
          "properties": {
            "mode": {"const": "verified_pulse_timing_reuse_v1"},
            "content_key": {"$ref": "#/$defs/sha"},
            "verified_receipt": {"$ref": "#/$defs/file"}
          }
        }
      ]
    },
    "verified_reuse_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "content_key", "verified_receipt"],
      "properties": {
        "mode": {"const": "verified_pulse_timing_reuse_v1"},
        "content_key": {"$ref": "#/$defs/sha"},
        "source_content_key": {"$ref": "#/$defs/sha"},
        "verified_receipt": {"$ref": "#/$defs/file"}
      }
    },
    "post_pulse_restart_reuse_authority": {
      "type": "object", "additionalProperties": false,
      "required": [
        "mode", "variation_axis", "producer_manifest", "checkpoint_output",
        "producer_pulse_schedule", "verified_pulse_receipt",
        "materialization_receipt", "provider_profiles", "consumer_profile_id",
        "producer_time_integration_profile_id", "consumer_time_integration_profile_id"
      ],
      "properties": {
        "mode": {"const": "manifest_bound_post_pulse_restart_reuse_v1"},
        "variation_axis": {
          "enum": [
            "time_integration_profile_id",
            "accelerator_field_profile_id",
            "diagnostic_state_transform",
            "accelerator_field_profile_id_and_diagnostic_state_transform",
            "accelerator_field_profile_id_and_source_zvz_theory_working_point"
          ]
        },
        "producer_manifest": {"$ref": "#/$defs/file"},
        "checkpoint_output": {"$ref": "#/$defs/file"},
        "producer_pulse_schedule": {"$ref": "#/$defs/file"},
        "verified_pulse_receipt": {"$ref": "#/$defs/file"},
        "materialization_receipt": {"$ref": "#/$defs/file"},
        "provider_profiles": {
          "type": "object", "additionalProperties": false,
          "required": [
            "time_integration_profile_id", "trajectory_quality_profile_id",
            "accelerator_field_profile_id"
          ],
          "properties": {
            "time_integration_profile_id": {"$ref": "#/$defs/id"},
            "trajectory_quality_profile_id": {"$ref": "#/$defs/id"},
            "accelerator_field_profile_id": {"$ref": "#/$defs/id"}
          }
        },
        "consumer_profile_id": {"$ref": "#/$defs/id"},
        "producer_time_integration_profile_id": {"$ref": "#/$defs/id"},
        "consumer_time_integration_profile_id": {"$ref": "#/$defs/id"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
