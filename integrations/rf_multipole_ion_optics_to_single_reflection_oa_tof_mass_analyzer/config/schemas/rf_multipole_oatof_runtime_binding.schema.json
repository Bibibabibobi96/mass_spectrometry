{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_runtime_binding.schema.json",
  "$ref": "#/$defs/active_v4",
  "$defs": {
    "active_v4": {
      "allOf": [
        {"$ref": "#/$defs/current_binding"},
        {
          "properties": {
            "schema_version": {"const": 4},
            "contracts": {"$ref": "#/$defs/active_contracts"}
          }
        }
      ]
    },
    "current_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role", "integration_id", "connection_profile_id", "upstream_project_id", "contracts"],
      "properties": {
        "schema_version": {"const": 4},
        "role": {"const": "rf_multipole_oatof_runtime_binding"},
        "integration_id": {"const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"},
        "connection_profile_id": {"$ref": "#/$defs/identifier"},
        "upstream_project_id": {"$ref": "#/$defs/identifier"},
        "contracts": {"type": "object"}
      }
    },
    "active_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_contract", "pre_pulse_contract", "pulse_capture_contract", "pulse_timing_contract", "handoff_contract", "handoff_publication_contract", "source_adapter_contract", "execution_policy_contract"],
      "properties": {
        "dependency_contract": {"$ref": "#/$defs/file"},
        "pre_pulse_contract": {"$ref": "#/$defs/file"},
        "pulse_capture_contract": {"$ref": "#/$defs/file"},
        "pulse_timing_contract": {"$ref": "#/$defs/file"},
        "handoff_contract": {"$ref": "#/$defs/file"},
        "handoff_publication_contract": {"$ref": "#/$defs/file"},
        "source_adapter_contract": {"$ref": "#/$defs/file"},
        "execution_policy_contract": {"$ref": "#/$defs/file"}
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
