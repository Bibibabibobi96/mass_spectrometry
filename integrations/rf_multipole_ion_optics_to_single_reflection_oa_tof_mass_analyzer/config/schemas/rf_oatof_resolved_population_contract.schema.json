{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_oatof_resolved_population_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "campaign_id", "experiment_id",
    "experiment_row_sha256", "population_declaration_sha256", "execution_strategy", "population_id", "population_mode",
    "source_authority", "execution_population", "denominators",
    "analysis_randomness", "postselection_policy"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "role": {"const": "rf_oatof_resolved_population_contract"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "experiment_id": {"$ref": "#/$defs/id"},
    "experiment_row_sha256": {"$ref": "#/$defs/sha"},
    "population_declaration_sha256": {"$ref": "#/$defs/sha"},
    "execution_strategy": {"enum": ["staged_three_stage", "simion_single_flight"]},
    "source_release_mode": {"enum": ["continuous_frontend", "continuous_frontend_handoff", "pre_pulse_restart"]},
    "single_flight_execution": {"$ref": "#/$defs/single_flight_execution"},
    "population_id": {"$ref": "#/$defs/id"},
    "population_mode": {
      "enum": [
        "staged_three_stage", "continuous_injection_full_population",
        "resolved_layout_pulse_ideal_linear_z_vz", "independent_spatial_velocity_ion_source_snapshot", "pre_pulse_restart", "terminal_handoff_continuation",
        "pulse_eligible_conditional", "first_100_rows_in_frozen_file_order",
        "first_n_rows_in_frozen_file_order"
      ]
    },
    "source_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_role", "table_binding", "table", "particle_count", "ordered_particle_ids"],
      "properties": {
        "input_role": {"type": "string", "minLength": 1},
        "table_binding": {"type": "string", "minLength": 1},
        "table": {"$ref": "#/$defs/file"},
        "particle_count": {"type": "integer", "minimum": 1},
        "ordered_particle_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "sha256"],
          "properties": {
            "encoding": {"const": "canonical_compact_json_integer_array_v1"},
            "sha256": {"$ref": "#/$defs/sha"}
          }
        }
      }
    },
    "execution_population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particle_count", "ordered_particle_id_sha256", "selection_algorithm", "selection_seed"],
      "properties": {
        "particle_count": {"type": "integer", "minimum": 1},
        "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"},
        "selection_algorithm": {"type": "string", "minLength": 1},
        "selection_seed": {"type": "integer", "minimum": 0}
      }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["population_count"],
      "properties": {
        "population_count": {"type": "integer", "minimum": 1},
        "pre_pulse_state_count": {"type": "integer", "minimum": 1},
        "eligible_population_count": {"type": "integer", "minimum": 1},
        "outside_transverse_bore_count": {"type": "integer", "minimum": 0},
        "derivation": {"enum": ["frozen_ordered_particle_id_membership", "event_membership_observed_during_analysis"]}
      }
    },
    "analysis_randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap_resample_count", "bootstrap_seed"],
      "properties": {
        "bootstrap_resample_count": {"type": "integer", "minimum": 0},
        "bootstrap_seed": {"type": "integer", "minimum": 0}
      }
    },
    "postselection_policy": {"enum": ["prohibited", "detector_blind_preregistered", "pulse_eligibility_only"]}
    ,"cohort_authority_mode": {"enum": ["establish_observed_authority", "require_frozen_baseline_authority"]}
    ,"paired_cohort_authority": {"$ref": "#/$defs/paired_cohort_authority"}
  },
  "oneOf": [
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend_handoff"},
        "population_mode": {"const": "terminal_handoff_continuation"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "terminal_handoff_continuation_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "terminal_handoff_continuation_global_state"}}},
        "execution_population": {"properties": {"selection_algorithm": {"enum": ["all_transmitted_terminal_handoffs_in_source_particle_id_order", "first_n_transmitted_terminal_handoffs_in_source_particle_id_order", "explicit_single_terminal_handoff_particle_id_v1"]}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "independent_spatial_velocity_ion_source_snapshot"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "candidate_full_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "prepared_materialized_ion_source_volume"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "staged_three_stage"},
        "population_mode": {"const": "staged_three_stage"},
        "source_authority": {"properties": {"table_binding": {"const": "staged_upstream_source"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "not": {"required": ["source_release_mode"]}
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "continuous_injection_full_population"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "candidate_full_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "source_contract_particle_source"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "resolved_layout_pulse_ideal_linear_z_vz"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "candidate_full_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "prepared_materialized_particle_source"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "pre_pulse_restart"},
        "population_mode": {"const": "pre_pulse_restart"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "source_contract_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": true}}},
        "source_authority": {"properties": {"table_binding": {"const": "experiment_pre_pulse_source_state"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "pulse_eligible_conditional"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "pulse_eligible_conditional_population"}, "requires_eligible_population": {"const": true}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "experiment_single_flight_particle_source"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "pulse_eligibility_only"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "first_100_rows_in_frozen_file_order"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "candidate_full_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "prepared_deterministic_prefix"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "first_100_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    },
    {
      "properties": {
        "execution_strategy": {"const": "simion_single_flight"},
        "source_release_mode": {"const": "continuous_frontend"},
        "population_mode": {"const": "first_n_rows_in_frozen_file_order"},
        "single_flight_execution": {"properties": {"population_basis": {"const": "candidate_full_population"}, "requires_eligible_population": {"const": false}, "is_pre_pulse_restart": {"const": false}}},
        "source_authority": {"properties": {"table_binding": {"const": "prepared_deterministic_prefix"}}},
        "execution_population": {"properties": {"selection_algorithm": {"const": "first_n_rows_in_frozen_file_order"}}},
        "postselection_policy": {"const": "prohibited"}
      },
      "required": ["source_release_mode"]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": 2},
          "execution_strategy": {"const": "simion_single_flight"}
        },
        "required": ["schema_version", "execution_strategy"]
      },
      "then": {"required": ["single_flight_execution"]}
    },
    {
      "if": {"required": ["paired_cohort_authority"]},
      "then": {"properties": {"denominators": {"required": [
        "population_count", "pre_pulse_state_count",
        "eligible_population_count", "outside_transverse_bore_count",
        "derivation"
      ]}}}
    },
    {
      "if": {
        "properties": {"cohort_authority_mode": {"const": "establish_observed_authority"}},
        "required": ["cohort_authority_mode"]
      },
      "then": {
        "not": {"required": ["paired_cohort_authority"]},
        "properties": {"denominators": {
          "required": ["population_count", "derivation"],
          "not": {"anyOf": [
            {"required": ["pre_pulse_state_count"]},
            {"required": ["eligible_population_count"]},
            {"required": ["outside_transverse_bore_count"]}
          ]},
          "properties": {"derivation": {"const": "event_membership_observed_during_analysis"}}
        }}
      }
    },
    {
      "if": {
        "properties": {"cohort_authority_mode": {"const": "require_frozen_baseline_authority"}},
        "required": ["cohort_authority_mode"]
      },
      "then": {"required": ["paired_cohort_authority"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "paired_cohort_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "source_release", "pre_pulse_state", "pulse_eligible",
        "outside_transverse_bore"
      ],
      "properties": {
        "role": {"const": "rf_oatof_observed_paired_cohort_authority"},
        "source_release": {"$ref": "#/$defs/cohort"},
        "pre_pulse_state": {"$ref": "#/$defs/cohort"},
        "pulse_eligible": {"$ref": "#/$defs/cohort"},
        "outside_transverse_bore": {"$ref": "#/$defs/cohort"}
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_particle_ids", "count", "ordered_particle_id_sha256"],
      "properties": {
        "ordered_particle_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "count": {"type": "integer", "minimum": 0},
        "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "single_flight_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_basis",
        "requires_eligible_population",
        "is_pre_pulse_restart"
      ],
      "properties": {
        "population_basis": {
          "enum": [
            "candidate_full_population",
            "pulse_eligible_conditional_population",
            "source_contract_population",
            "terminal_handoff_continuation_population"
          ]
        },
        "requires_eligible_population": {"type": "boolean"},
        "is_pre_pulse_restart": {"type": "boolean"}
      }
    }
  }
}
