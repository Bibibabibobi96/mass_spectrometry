{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_source_population_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "status", "source_state", "selector", "particle_count", "ordered_particle_id_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "rf_multipole_oatof_source_population_receipt"},
    "status": {"const": "PASS"},
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha"}}
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "status"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "particle_count": {"type": "integer", "minimum": 1},
    "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}
