{
  "schema_version": 2,
  "role": "rf_to_oatof_shared_physical_port_joint_geometry",
  "status": "authoritative_for_family_connector_and_pulse_stages",
  "integration_id": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer",
  "consumer_scope": "rf_multipole_registered_handoff_family",
  "scope": "Family-neutral oaTOF-shield terminal electrode and local joint geometry; family rod count, drive pattern and resolved geometry are consumed from the selected runtime binding.",
  "authoritative_inputs": {
    "source_contract": "run_input:resolved_source_contract",
    "rf_resolved_geometry": "run_input:upstream_resolved_design",
    "resolved_connection": "runtime_resolved_connection",
    "oatof_baseline": "dependency_contract:oatof_baseline",
    "downstream_terminal_profile_registry": "config/downstream_terminal_profiles.json",
    "downstream_terminal_profile_id": "oatof_shield_terminal"
  },
  "physical_boundaries": {
    "source_exit_surface": {
      "frame_id": "multipole_cartesian_z_axis_v1",
      "geometry": "plane",
      "local_center_mm": [0.0, 0.0, 80.6],
      "outward_normal": [0.0, 0.0, 1.0],
      "bindings": {
        "local_center_z_mm": {
          "source_input": "rf_resolved_geometry",
          "json_pointer": "/interfaces_mm/exit/handoff_plane_z_mm"
        },
        "outward_normal": {
          "source_input": "rf_resolved_geometry",
          "json_pointer": "/coordinate/axial_axis",
          "expected_source_value": "+z"
        }
      },
      "physical_aperture": {
        "shape_binding": "resolved_connection:/transition_aperture/shape",
        "full_width_y_mm_binding": "resolved_connection:/transition_aperture/full_width_mm",
        "full_height_z_mm_binding": "resolved_connection:/transition_aperture/full_height_mm",
        "source_binding": "resolved_connection:/transition_aperture"
      }
    },
    "target_entry_surface": {
      "frame_id": "oatof_global",
      "geometry": "plane_on_negative_x_outer_shield_face",
      "center_mm": [-67.8, 0.0, -18.42918680341103],
      "outward_normal": [-1.0, 0.0, 0.0],
      "reference_binding": {
        "source_input": "oatof_baseline",
        "derivation": "center_x_mm = accelerator_axis_x - accelerator_bore_half - accelerator_ring_width - accelerator_insulation_gap - accelerator_shield_wall; center_y_mm and center_z_mm use particle_source center"
      }
    }
  },
  "electrical_interface": {
    "common_potential_reference": {
      "potential_V": 0.0,
      "unit": "V",
      "source_bindings": [
        "rf_resolved_geometry:/drive/common_mode_offset_V",
        "oatof_baseline:/electrodes_V/shield"
      ],
      "scope": "The oaTOF shield is the downstream-owned terminal electrode and remains the zero-volt reference."
    },
    "terminal_electrode": {
      "owner": "downstream",
      "terminal_profile_id": "oatof_shield_terminal",
      "component_id": "single_reflection_oa_tof_mass_analyzer",
      "geometry_tag": "accelshield",
      "serves_as_multipole_exit_aperture_electrode": true,
      "separate_upstream_exit_plate_allowed": false,
      "potential_V": 0.0,
      "potential_binding": "rf_resolved_geometry:/downstream_terminal/terminal_potential_V"
    }
  },
  "nominal_registration": {
    "instrument_frame": "oatof_global",
    "source_component_pose": "resolved_connection.spatial_registration",
    "source_exit_center_local_mm": [0.0, 0.0, 80.6],
    "source_exit_center_instrument_mm": [-67.8, 0.0, -18.42918680341103],
    "target_entry_center_instrument_mm": [-67.8, 0.0, -18.42918680341103],
    "direct_mating_gap_mm": 0.0,
    "axis_mapping": "multipole +z -> oa +x; multipole +x -> oa +y; multipole +y -> oa +z"
  },
  "terminal_geometry": {
    "rod_end_to_terminal_outer_face_mm": 1.0,
    "rod_end_binding": "rf_resolved_geometry:/geometry_mm/rod_array/rods[*]/z_max_mm",
    "terminal_outer_face_binding": "rf_resolved_geometry:/interfaces_mm/exit/handoff_plane_z_mm",
    "terminal_aperture_shape": "rectangle",
    "terminal_aperture_binding": "rf_resolved_geometry:/downstream_terminal/aperture",
    "interference_policy": "downstream_owned_terminal_replaces_upstream_exit_plate"
  },
  "local_domain": {
    "rf_shield_inner_radius_mm": 19.776,
    "rf_shield_numerical_wall_thickness_mm": 1.0,
    "oatof_downstream_buffer_after_grid2_mm": 5.0
  },
  "diagnostic_events": {
    "local_accelerator_exit": {
      "frame_id": "oatof_global",
      "geometry": "plane",
      "physical_surface_role": "accelerator_grid2",
      "z_binding": "oatof_baseline:/geometry_mm/accelerator_grid2_z",
      "sampling_offset_mm": 0.0,
      "numerical_domain_boundary_allowed": false,
      "required_consumers": ["comsol_pulse_capture", "simion_interface_transport", "cross_solver_analysis"]
    }
  },
  "port_sweep": {
    "shape_binding": "resolved_connection:/transition_aperture/shape",
    "center_z_binding": "resolved_connection:/spatial_registration/translation_mm/2",
    "full_width_y_mm_binding": "resolved_connection:/transition_aperture/full_width_mm",
    "full_height_z_mm_binding": "resolved_connection:/transition_aperture/full_height_mm",
    "particle_release_offset_inside_outer_face_mm": 0.001
  },
  "field_basis": {
    "shared_geometry_required": true,
    "superposition_order": ["axial_dc", "rf_unit", "oatof_pulse"],
    "axial_dc": {
      "always_enabled": true,
      "rod_common_mode_source": "rf_resolved_geometry:/axial_dc/rod_electrodes",
      "entrance_reference_sleeve_potential_source": "rf_resolved_geometry:/axial_dc/entrance_reference_sleeve/potential_V",
      "upstream_grounded_hardware_source": "rf_resolved_geometry:/axial_dc",
      "terminal_electrode_potential_source": "rf_resolved_geometry:/axial_dc/terminal_electrode_potential_V",
      "all_oatof_pulse_electrodes_V": 0.0
    },
    "rf_unit": {
      "rod_differential_pattern_V": [100.0, -100.0],
      "rod_assignment_source": "rf_resolved_geometry:/geometry_mm/rod_array/rods[*]/electrode_group",
      "all_oatof_electrodes_and_grounded_hardware_V": 0.0,
      "runtime_scale": "V_rf_peak/100[V] * sin(2*pi*f_rf*instrument_time + phase)"
    },
    "oatof_pulse": {
      "runtime_scale": "pulse_schedule_gate",
      "shield_potential_V": 0.0,
      "grid2_potential_V": 0.0,
      "nominal_electrode_differences_source": "oatof_baseline:/electrodes_V",
      "all_multipole_hardware_V": 0.0
    }
  }
}
