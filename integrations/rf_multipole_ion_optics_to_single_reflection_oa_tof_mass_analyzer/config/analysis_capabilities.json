{
  "schema_version": 1,
  "role": "rf_multipole_oatof_analysis_capability_catalog",
  "integration_id": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer",
  "capabilities": [
    {
      "capability_id": "rf_oatof_single_flight_aperture_comparison_v1",
      "consumer": "analysis/compare_single_flight_apertures.py",
      "scope": "paired event identity, spatial residual, transmission and direct-KDE resolution comparison for two continuous-flight grounded aperture profiles",
      "fixed_output_role": "results/single_flight_aperture_comparison.png",
      "claim_class": "engineering_diagnostic"
    },
    {
      "capability_id": "rf_oatof_single_flight_spatial_six_panel_v1",
      "consumer": "analysis/plot_single_flight_spatial_six_panel.py",
      "scope": "continuous-flight release, handoff, pre-pulse, accelerator-exit and detector spatial snapshots with governed component outlines",
      "fixed_output_role": "results/single_flight_spatial_six_panel.png",
      "claim_class": "engineering_diagnostic"
    },
    {
      "capability_id": "rf_oatof_pulse_geometry_snapshot_v1",
      "consumer": "analysis/plot_shared_pulse_geometry_snapshot.py",
      "scope": "COMSOL particle positions and losses immediately before the shared pulse",
      "fixed_output_role": "results/pulse_capture_pulse_geometry_snapshot.png",
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    },
    {
      "capability_id": "rf_oatof_analyzer_functional_chain_v1",
      "consumer": "analysis/analyze_analyzer_transport.py",
      "scope": "single-case downstream SIMION census and detector-hit TOF",
      "fixed_output_role": "results/analyzer_transport_functional_chain.png",
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    },
    {
      "capability_id": "rf_oatof_campaign_comparison_v1",
      "consumer": "analysis/publish_campaign_comparison_run.py",
      "scope": "two-to-four-case normalized retention and detector-hit TOF comparison",
      "fixed_output_role": "results/campaign_comparison.png",
      "claim_class": "POSTHOC_DESCRIPTIVE"
    },
    {
      "capability_id": "rf_oatof_chain_checkpoint_six_panel_v1",
      "consumer": "analysis/plot_chain_checkpoint_diagnostics.py",
      "scope": "per-case six-panel RF-exit, oaTOF-entry, pulse, grid2-exit and detector diagnostic",
      "required_event_plane": "diagnostic_events.local_accelerator_exit",
      "fixed_output_role": "results/<case>__chain_checkpoint_diagnostics.png",
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    },
    {
      "capability_id": "rf_oatof_grid2_downstream_six_panel_resolution_v1",
      "consumer": "analysis/plot_grid2_downstream_six_panel.py",
      "scope": "per-branch grid2 phase space, detector acceptance and Gaussian analyzer-TOF FWHM resolution proxy",
      "required_event_plane": "diagnostic_events.local_accelerator_exit",
      "fixed_output_role": "results/<case>_six_panel.png",
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    },
    {
      "capability_id": "rf_oatof_ideal_actual_resolution_gap_v1",
      "consumer": "analysis/plot_ideal_actual_resolution_gap.py",
      "scope": "ideal source volume versus multipole-fed pulse position, grid2 angle-energy state, TOF error and resolution gap",
      "required_event_plane": "diagnostic_events.local_accelerator_exit",
      "fixed_output_role": "results/ideal_actual_resolution_gap_six_panel.png",
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    },
    {
      "capability_id": "rf_oatof_pre_pulse_checkpoint_state_v1",
      "consumer": "analysis/analyze_single_flight.py",
      "scope": "family-source-closure detector-blind pre-pulse z-vz checkpoint state for the governed execution population; interventions are declared by campaign source and field profiles, not synthesized by a second runner",
      "fixed_output_role": "results/single_flight_particle_checkpoints.csv",
      "claim_class": "CONTROLLED_COUNTERFACTUAL_DIAGNOSTIC_ONLY"
    }
  ]
}
