{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/simion_rectangular_aperture_discretization.schema.json",
  "title": "Repository-wide SIMION rectangular aperture discretization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "mechanical_width_mm",
    "mechanical_height_mm",
    "cell_mm_xyz",
    "boolean_boundary_policy",
    "numerical_carve_width_mm",
    "numerical_carve_height_mm",
    "compiled_pa_open_column_check_required",
    "flange_min_mm",
    "flange_max_mm",
    "grid_alignment",
    "normal_axis",
    "center_mm",
    "pa_origin_mm"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "role": {
      "const": "simion_rectangular_aperture_discretization"
    },
    "mechanical_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mechanical_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cell_mm_xyz": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "boolean_boundary_policy": {
      "enum": [
        "exclude_shape_inside_only_v1",
        "exclude_shape_inside_or_on_v1"
      ]
    },
    "numerical_carve_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "numerical_carve_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "compiled_pa_open_column_check_required": {
      "const": true
    },
    "grid_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_cells",
        "height_cells",
        "width_is_integer_cell_multiple",
        "height_is_integer_cell_multiple",
        "edge_grid_coordinates",
        "edges_on_grid_nodes",
        "warnings"
      ],
      "properties": {
        "width_cells": {
          "type": "number",
          "minimum": 1
        },
        "height_cells": {
          "type": "number",
          "minimum": 1
        },
        "width_is_integer_cell_multiple": {
          "type": "boolean"
        },
        "height_is_integer_cell_multiple": {
          "type": "boolean"
        },
        "edge_grid_coordinates": {
          "$ref": "#/$defs/edge_numbers"
        },
        "edges_on_grid_nodes": {
          "$ref": "#/$defs/edge_booleans"
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "aperture_width_not_integer_cell_multiple",
              "aperture_height_not_integer_cell_multiple",
              "aperture_y_edges_not_on_grid_nodes",
              "aperture_z_edges_not_on_grid_nodes",
              "aperture_x_edges_not_on_grid_nodes"
            ]
          }
        }
      }
    },
    "flange_min_mm": {
      "type": "number"
    },
    "flange_max_mm": {
      "type": "number"
    },
    "normal_axis": {
      "enum": [
        "x",
        "y",
        "z"
      ]
    },
    "center_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "pa_origin_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    }
  },
  "$defs": {
    "edge_numbers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "type": "number"
        },
        "x_max": {
          "type": "number"
        },
        "y_min": {
          "type": "number"
        },
        "y_max": {
          "type": "number"
        },
        "z_min": {
          "type": "number"
        },
        "z_max": {
          "type": "number"
        }
      },
      "minProperties": 4,
      "maxProperties": 4
    },
    "edge_booleans": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_min": {
          "type": "boolean"
        },
        "x_max": {
          "type": "boolean"
        },
        "y_min": {
          "type": "boolean"
        },
        "y_max": {
          "type": "boolean"
        },
        "z_min": {
          "type": "boolean"
        },
        "z_max": {
          "type": "boolean"
        }
      },
      "minProperties": 4,
      "maxProperties": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "normal_axis": {
            "const": "x"
          }
        }
      },
      "then": {
        "properties": {
          "grid_alignment": {
            "properties": {
              "edge_grid_coordinates": {
                "required": [
                  "y_min",
                  "y_max",
                  "z_min",
                  "z_max"
                ]
              },
              "edges_on_grid_nodes": {
                "required": [
                  "y_min",
                  "y_max",
                  "z_min",
                  "z_max"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "normal_axis": {
            "const": "y"
          }
        }
      },
      "then": {
        "properties": {
          "grid_alignment": {
            "properties": {
              "edge_grid_coordinates": {
                "required": [
                  "x_min",
                  "x_max",
                  "z_min",
                  "z_max"
                ]
              },
              "edges_on_grid_nodes": {
                "required": [
                  "x_min",
                  "x_max",
                  "z_min",
                  "z_max"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "normal_axis": {
            "const": "z"
          }
        }
      },
      "then": {
        "properties": {
          "grid_alignment": {
            "properties": {
              "edge_grid_coordinates": {
                "required": [
                  "x_min",
                  "x_max",
                  "y_min",
                  "y_max"
                ]
              },
              "edges_on_grid_nodes": {
                "required": [
                  "x_min",
                  "x_max",
                  "y_min",
                  "y_max"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
