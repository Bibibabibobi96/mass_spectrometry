{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/multipole_operating_modes.schema.json",
  "title": "Typed RF multipole electrical operating modes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "project_id",
    "family_id",
    "terminal_reference_V",
    "modes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "role": {
      "const": "multipole_typed_operating_mode_registry"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "family_id": {
      "const": "rf_multipole_ion_optics"
    },
    "terminal_reference_V": {
      "const": 0.0
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode_id",
          "axial_drive_topology",
          "rod_entrance_relative_to_terminal_V",
          "rod_exit_relative_to_terminal_V"
        ],
        "properties": {
          "mode_id": {
            "$ref": "#/$defs/identifier"
          },
          "axial_drive_topology": {
            "enum": [
              "none",
              "segmented_rod_axial_acceleration"
            ]
          },
          "rod_entrance_relative_to_terminal_V": {
            "type": "number"
          },
          "rod_exit_relative_to_terminal_V": {
            "type": "number"
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    }
  }
}
