{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_registry.schema.json",
  "title": "Registered integration families",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integrations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "role": {
      "const": "integration_registry"
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "integration_id",
          "root"
        ],
        "properties": {
          "integration_id": {
            "$ref": "#/$defs/identifier"
          },
          "profile_registry": {},
          "root": {
            "type": "string",
            "pattern": "^integrations(?:/[a-z][a-z0-9_]*)?$",
            "description": "Source root; integration_id remains the explicit owner identity."
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow_id",
                "entrypoint",
                "required_bindings",
                "arguments",
                "outputs",
                "simulation_paths",
                "recipes",
                "limitations",
                "purpose",
                "action",
                "tools",
                "model"
              ],
              "properties": {
                "workflow_id": {
                  "$ref": "#/$defs/identifier"
                },
                "entrypoint": {
                  "type": "string",
                  "pattern": "^integrations/workflows/.+\\.ps1$"
                },
                "required_bindings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "simulation_paths": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "segmented_handoff",
                      "continuous_assembly"
                    ]
                  }
                },
                "recipes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "binding_types": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "file",
                      "directory",
                      "integer",
                      "number",
                      "string"
                    ]
                  }
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "const": "run"
                },
                "tools": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "scientific_status": {
                  "const": "not_evaluated"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "root": {
                  "const": "integrations"
                }
              }
            },
            "then": {
              "properties": {
                "profile_registry": {
                  "$ref": "#/$defs/direct_registry_path"
                }
              }
            },
            "else": {
              "properties": {
                "profile_registry": {
                  "$ref": "#/$defs/family_registry_path"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "direct_registry_path": {
      "type": "string",
      "pattern": "^integrations/config/[A-Za-z0-9._-]+\\.json$"
    },
    "family_registry_path": {
      "type": "string",
      "pattern": "^integrations/[a-z][a-z0-9_]*/config/[A-Za-z0-9._-]+\\.json$",
      "description": "Consumers must also verify that the path belongs to the declared root."
    }
  }
}
