{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_identity_migration.schema.json",
  "title": "Retired artifact project identity migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "migration_id", "status", "recorded_at_utc",
    "current_project_id", "legacy_project_id", "legacy_mapping_id",
    "source_root", "destination_root", "relocation", "inventory",
    "identity_anomalies", "files"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "role": {"const": "artifact_identity_migration_manifest"},
    "migration_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "relocated_verified"]},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "current_project_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "legacy_project_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "legacy_mapping_id": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "destination_root": {"type": "string", "minLength": 1},
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "legacy_manifests_rewritten", "recorded_project_identity_preserved"],
      "properties": {
        "kind": {"const": "exact_root_prefix"},
        "legacy_manifests_rewritten": {"const": false},
        "recorded_project_identity_preserved": {"const": true}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_count", "bytes", "prune_candidate_file_count", "prune_candidate_bytes",
        "identity_anomaly_count", "identity_anomaly_file_count"
      ],
      "properties": {
        "file_count": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "prune_candidate_file_count": {"type": "integer", "minimum": 0},
        "prune_candidate_bytes": {"type": "integer", "minimum": 0},
        "identity_anomaly_count": {"type": "integer", "minimum": 0},
        "identity_anomaly_file_count": {"type": "integer", "minimum": 0}
      }
    },
    "identity_anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path", "run_id", "manifest_path", "manifest_section", "recorded_path",
          "recorded_bytes", "actual_bytes", "recorded_sha256", "actual_sha256",
          "mismatches"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "run_id": {"type": "string", "minLength": 1},
          "manifest_path": {"type": "string", "minLength": 1},
          "manifest_section": {"enum": ["inputs", "outputs"]},
          "recorded_path": {"type": "string", "minLength": 1},
          "recorded_bytes": {"type": ["integer", "null"], "minimum": 0},
          "actual_bytes": {"type": ["integer", "null"], "minimum": 0},
          "recorded_sha256": {"type": ["string", "null"]},
          "actual_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9A-F]{64}$"
          },
          "mismatches": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "missing_local_file", "invalid_recorded_bytes", "bytes_mismatch",
                "invalid_recorded_sha256", "sha256_mismatch"
              ]
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path", "bytes", "sha256", "disposition", "reason", "run_id", "reference_classes"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
          "disposition": {"enum": ["retain", "prune_after_verified_migration"]},
          "reason": {
            "type": ["string", "null"],
            "enum": [
              null, "non_authoritative_workspace", "rebuildable_solver_or_cad_binary",
              "manifest_identity_anomaly"
            ]
          },
          "run_id": {"type": ["string", "null"]},
          "reference_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["active", "formal", "history"]}
          }
        }
      }
    }
  }
}
