{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/connection_profile_registry.schema.json",
  "title": "Connection profile registry for one integration family",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "connection_profile_registry"},
    "integration_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://mass-spectrometry.local/schemas/connection_profile.schema.json"}
    }
  }
}
