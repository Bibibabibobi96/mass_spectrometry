{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_artifact_identity.schema.json",
  "title": "Integration run identity bound to its frozen assembly plan",
  "description": "The composition plan owns recipe and component instance identities; they are not copied into a second authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "integration_id",
    "workflow_id",
    "run_id",
    "composition_plan"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "integration_id": {
      "$ref": "#/$defs/identifier"
    },
    "workflow_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "composition_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "composition_plan.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    }
  }
}
