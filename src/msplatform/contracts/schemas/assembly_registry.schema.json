{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/assembly_registry.schema.json",
  "title": "Registered assemblies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "assemblies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "role": {
      "const": "assembly_registry"
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assembly_id"
        ],
        "properties": {
          "assembly_id": {
            "$ref": "#/$defs/identifier"
          },
          "profile_registry": {
            "$ref": "#/$defs/registry_path"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow_id",
                "entrypoint",
                "required_bindings",
                "arguments",
                "outputs",
                "simulation_paths",
                "recipes",
                "limitations",
                "purpose",
                "action",
                "tools",
                "model"
              ],
              "properties": {
                "workflow_id": {
                  "$ref": "#/$defs/identifier"
                },
                "entrypoint": {
                  "$ref": "#/$defs/workflow_entrypoint"
                },
                "required_bindings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "arguments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "optional_arguments": {
                  "type": "object",
                  "propertyNames": {"$ref": "#/$defs/identifier"},
                  "additionalProperties": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "default": {}
                },
                "run_identity": {
                  "enum": ["caller_selected", "backend_generated"],
                  "description": "Whether the entry consumes the planned run ID or returns the public backend owner's actual generated identity."
                },
                "outputs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "simulation_paths": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "segmented_handoff",
                      "continuous_assembly"
                    ]
                  }
                },
                "recipes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/workflow_input"
                  }
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "binding_types": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "file",
                      "directory",
                      "run_directory",
                      "integer",
                      "number",
                      "string"
                    ]
                  }
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "const": "run"
                },
                "tools": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "scientific_status": {
                  "const": "not_evaluated"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "registry_path": {
      "type": "string",
      "pattern": "^src/msplatform/workflows/config/[A-Za-z0-9._-]+\\.json$"
    },
    "workflow_entrypoint": {
      "type": "string",
      "pattern": "^src/msplatform/workflows/resources/[A-Za-z0-9_]+\\.ps1$"
    },
    "workflow_input": {
      "type": "string",
      "pattern": "^src/msplatform/workflows/config/[A-Za-z0-9._-]+\\.json$"
    }
  }
}
