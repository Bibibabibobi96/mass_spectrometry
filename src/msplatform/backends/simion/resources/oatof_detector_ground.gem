; The physical-body mode renders the selected canonical grounded detector.
; Capture and numerical marker controls remain separate from the physical body.

# local var = assert(_G.var, 'frozen numerical marker required')
# local mmgu_xy = var.mmgu_xy
# local mmgu_z = var.mmgu_z
# local radius = var.radius
# local absorber_thickness = var.absorber_thickness
# local margin_xy = var.margin_xy
# local front_margin_z = var.front_margin_z
# local back_margin_z = var.back_margin_z
# local xy_span = 2*(radius+margin_xy)
# local z_span = front_margin_z+absorber_thickness+back_margin_z
# local nx = math.floor(xy_span/mmgu_xy + 0.5) + 1
# local ny = nx
# local nz = var.back_cells + var.front_cells + 1
# local cx = xy_span/2
# local cy = xy_span/2
# local incoming_face_z = var.back_cells*mmgu_z

pa_define($(nx),$(ny),$(nz),planar,none,electrostatic,,
          $(mmgu_xy),$(mmgu_xy),$(mmgu_z),surface=fractional)

e(1) {
  ; The SIMION cylinder extends toward negative local z.  Its anchor is the
  ; incoming active face; the numerical layer remains at least five z cells.
  locate($(cx),$(cy),$(incoming_face_z)) {
    fill { within { cylinder(0,0,0,$(radius),,$(absorber_thickness)) } }
  }
}
