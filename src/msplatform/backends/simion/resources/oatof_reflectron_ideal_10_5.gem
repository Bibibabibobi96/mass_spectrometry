; Native cylindrical projection of the provider's resolved physical electrodes.
# local var = assert(_G.var, 'provider projection required')
# local component = assert(var.component, 'reflectron projection required')
# local nx = math.ceil(component.axial_span_mm/var.mmgu_axial)+1
# local ny = math.ceil(component.outer_radius_mm/var.mmgu_radial)+1
pa_define($(nx),$(ny),1,cylindrical,y,electrostatic,,
          $(var.mmgu_axial),$(var.mmgu_radial),$(var.mmgu_radial),surface=none)
# for _, electrode in ipairs(component.electrodes) do
e($(electrode.local_electrode_id)) {
# for _, region in ipairs(electrode.regions) do
  fill{within{box($(region.axial_mm[1]),$(region.radius_mm[1]),$(region.axial_mm[2]),$(region.radius_mm[2]))}}
# end
}
# end
