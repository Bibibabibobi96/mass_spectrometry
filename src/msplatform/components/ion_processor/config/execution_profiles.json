{
  "schema_version": 2,
  "role": "project_execution_profiles",
  "project_id": "ion_processor",
  "profiles": [
    {
      "profile_id": "native_functional",
      "capability_id": "native_electrode_functional_transport",
      "mode": "native_electrode_functional",
      "supported_objectives": [
        "capture_fraction",
        "extraction_fraction"
      ],
      "supported_operating_points": [
        {
          "mass": {
            "value": 524,
            "unit": "Da"
          },
          "charge_state": 1
        }
      ],
      "supported_design_variables": [],
      "supported_constraints": [],
      "deliverable_outputs": [
        "simulation_results",
        "simion_model",
        "validation_report",
        "interface_state"
      ],
      "required_bindings": [
        "workspace",
        "execution_environment",
        "environment_profile",
        "artifact_root"
      ],
      "steps": [
        {
          "step_id": "native_run",
          "kind": "run",
          "shell": "python",
          "entrypoint": "src/msplatform/cli.py",
          "run_id_template": "{timestamp}__sim__simion__ion-processor-native-functional",
          "arguments": [
            "ion-processor-native-functional",
            "run",
            "--run-id",
            "{native_run_id}",
            "--source-profile",
            "functional",
            "--configuration-directory",
            "{resolved_configuration_directory}",
            "--execution-environment",
            "{execution_environment}",
            "--environment-profile",
            "{environment_profile}",
            "--workspace",
            "{workspace}",
            "--artifact-root",
            "{artifact_root}"
          ]
        }
      ],
      "limitations": [
        "Fixed existing native-electrode functional evaluation; no optimization or request-specific physical parameter synthesis.",
        "Only the canonical 524 Da/+1 functional source and project configuration are registered; custom configuration, exploration, upstream admission and GUI replay remain project workflows.",
        "Prototype engineering execution only: no Static, Candidate or Formal scientific qualification is granted, and measured acceptance may fail.",
        "Retention and resource declarations are owned by config/runtime_profiles.json; live worker scheduling remains repository-owned and new runs require an explicit ArtifactStore and execution environment."
      ],
      "binding_types": {
        "workspace": "directory",
        "execution_environment": "file",
        "environment_profile": "string",
        "artifact_root": "directory"
      },
      "fixed_inputs": {
        "baseline": "config/baseline.json",
        "numerics": "config/numerics.json",
        "source": "config/source.json",
        "gas_environment": "config/gas_environment.json",
        "acceptance": "config/acceptance.json",
        "native_operating_point": "config/native_operating_point.json",
        "diagnostics": "config/diagnostics.json",
        "field_diagnostics": "config/field_diagnostics.json",
        "coordinate_transform": "config/coordinate_transform.json",
        "geometry_sources": "config/geometry_sources.json",
        "source_parameter_sources": "config/source_parameter_sources.json"
      },
      "purpose": "functional_transport",
      "action": "run",
      "tools": [
        "simion",
        "python"
      ],
      "model": "双压力区矩形RF电极与碰撞离子输运",
      "scientific_status": "not_evaluated"
    }
  ]
}
