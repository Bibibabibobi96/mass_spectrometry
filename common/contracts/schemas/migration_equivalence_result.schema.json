{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/migration_equivalence_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "status",
    "decision_scope",
    "oracle",
    "preregistration",
    "profiles",
    "continuous_state",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_migration_equivalence_result"},
    "integration_id": {"$ref": "#/$defs/identifier"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "decision_scope": {"const": "zero_physics_change_functional_migration"},
    "oracle": {"$ref": "#/$defs/source"},
    "preregistration": {"$ref": "#/$defs/source"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_profile_id",
          "integration_run_id",
          "status",
          "source_identity_exact",
          "census_exact",
          "particle_event_sets",
          "stage_runs"
        ],
        "properties": {
          "connection_profile_id": {"$ref": "#/$defs/identifier"},
          "integration_run_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "source_identity_exact": {"type": "boolean"},
          "census_exact": {"type": "boolean"},
          "particle_event_sets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phase", "legacy_result", "status", "rows"],
              "properties": {
                "phase": {"$ref": "#/$defs/identifier"},
                "legacy_result": {"$ref": "#/$defs/identifier"},
                "status": {"enum": ["PASS", "FAIL"]},
                "rows": {"type": "integer", "minimum": 0}
              }
            }
          },
          "stage_runs": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phase", "run_id", "manifest_sha256"],
              "properties": {
                "phase": {"$ref": "#/$defs/identifier"},
                "run_id": {"type": "string", "minLength": 1},
                "manifest_sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "continuous_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "blocks_functional_migration_equivalence"],
      "properties": {
        "status": {"const": "NOT_EVALUATED"},
        "reason": {"type": "string", "minLength": 1},
        "blocks_functional_migration_equivalence": {"const": false}
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/).+"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
