{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_family_source_revision_preregistration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "source_revision_id",
    "preregistered_before_run",
    "execution_status",
    "engineering_budget",
    "profile",
    "comparison",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_family_source_revision_preregistration"},
    "integration_id": {
      "const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"
    },
    "source_revision_id": {"$ref": "#/$defs/identifier"},
    "preregistered_before_run": {"const": true},
    "execution_status": {"const": "NOT_RUN"},
    "engineering_budget": {"$ref": "#/$defs/status_file"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_profile_id",
        "source_contract",
        "runtime_binding",
        "source_branch_ids",
        "particle_count",
        "run_status"
      ],
      "properties": {
        "connection_profile_id": {"$ref": "#/$defs/identifier"},
        "source_contract": {"$ref": "#/$defs/file"},
        "runtime_binding": {"$ref": "#/$defs/file"},
        "source_branch_ids": {
          "type": "array",
          "prefixItems": [{"const": "comsol"}],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "particle_count": {"const": 100},
        "run_status": {"const": "NOT_RUN"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_parent_run_id",
        "only_changed_variable",
        "required_metrics",
        "expansion_rule"
      ],
      "properties": {
        "baseline_parent_run_id": {"type": "string", "minLength": 1},
        "only_changed_variable": {"const": "upstream_comsol_source_revision"},
        "required_metrics": {
          "type": "array",
          "prefixItems": [
            {"const": "rf_exit_count"},
            {"const": "oatof_entry_count"},
            {"const": "active_at_pulse_count"},
            {"const": "local_accelerator_exit_count"},
            {"const": "detector_crossing_count"},
            {"const": "detector_hit_count"},
            {"const": "common_local_exit_position_rms_mm"},
            {"const": "common_local_exit_velocity_rms_m_per_s"},
            {"const": "common_local_exit_time_rms_us"},
            {"const": "common_local_exit_energy_rms_eV"}
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "expansion_rule": {"type": "string", "minLength": 1}
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "status_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "REQUIRED_BEFORE_SOLVER_EXECUTION"}
      }
    }
  }
}
