{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_family_source_revision_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "revisions"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_family_source_revision_registry"},
    "integration_id": {
      "const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"
    },
    "revisions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_revision_id",
          "connection_profile_id",
          "source_branch_ids",
          "preregistration",
          "runtime_binding"
        ],
        "properties": {
          "source_revision_id": {"$ref": "#/$defs/identifier"},
          "connection_profile_id": {"$ref": "#/$defs/identifier"},
          "source_branch_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["comsol", "simion"]}
          },
          "preregistration": {"$ref": "#/$defs/file"},
          "runtime_binding": {"$ref": "#/$defs/file"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
