{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_source_contract.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/legacy_v1"},
    {"$ref": "#/$defs/family_v2"}
  ],
  "$defs": {
    "legacy_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "role",
        "upstream_project_id",
        "recorded_project_id",
        "selector",
        "adapter",
        "canonical_state",
        "source"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "role": {"const": "rf_multipole_oatof_source_contract"},
        "upstream_project_id": {"$ref": "#/$defs/identifier"},
        "recorded_project_id": {"$ref": "#/$defs/identifier"},
        "selector": {"$ref": "#/$defs/selector"},
        "adapter": {"$ref": "#/$defs/legacy_adapter"},
        "canonical_state": {"$ref": "#/$defs/canonical_state"},
        "source": {"$ref": "#/$defs/legacy_source"}
      }
    },
    "family_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "role",
        "upstream_project_id",
        "selector",
        "adapter",
        "canonical_state",
        "source_branches"
      ],
      "properties": {
        "schema_version": {"const": 2},
        "role": {"const": "rf_multipole_oatof_source_contract"},
        "upstream_project_id": {"$ref": "#/$defs/identifier"},
        "selector": {"$ref": "#/$defs/selector"},
        "adapter": {"$ref": "#/$defs/family_adapter"},
        "canonical_state": {
          "allOf": [
            {"$ref": "#/$defs/canonical_state"},
            {
              "properties": {
                "frame_id": {"const": "multipole_cartesian_z_axis_v1"},
                "clock_epoch_id": {"const": "instrument_clock_epoch_v1"}
              }
            }
          ]
        },
        "source_branches": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comsol", "simion"],
          "properties": {
            "comsol": {
              "$ref": "#/$defs/comsol_branch"
            },
            "simion": {
              "$ref": "#/$defs/simion_branch"
            }
          }
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "status"],
      "properties": {
        "event": {"const": "handoff"},
        "status": {"const": "transmitted"}
      }
    },
    "legacy_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "callable",
        "output_schema",
        "dependencies"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "callable": {"const": "build_handoff"},
        "output_schema": {"const": "component_particle_state_v1"},
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_baseline",
            "energy_match_contract",
            "source_interface_contract"
          ],
          "properties": {
            "source_baseline": {"$ref": "#/$defs/file"},
            "energy_match_contract": {"$ref": "#/$defs/file"},
            "source_interface_contract": {"$ref": "#/$defs/file"}
          }
        }
      }
    },
    "family_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "callable",
        "output_schema",
        "dependencies"
      ],
      "properties": {
        "path": {
          "const": "integrations/rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer/analysis/publish_family_source_bundle.py"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "callable": {"const": "publish_family_source_bundle"},
        "output_schema": {"const": "component_particle_state_v1"},
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["handoff_publication_contract"],
          "properties": {
            "handoff_publication_contract": {"$ref": "#/$defs/file"}
          }
        }
      }
    },
    "canonical_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "clock_epoch_id",
        "lineage_policy",
        "species_policy"
      ],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "clock_epoch_id": {"type": "string", "minLength": 1},
        "lineage_policy": {
          "const": "preserve_root_birth_time_and_component_elapsed_time"
        },
        "species_policy": {
          "const": "frozen_particle_source_mass_and_charge"
        }
      }
    },
    "comsol_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver_id", "recorded_project_id", "source"],
      "properties": {
        "solver_id": {"const": "comsol"},
        "recorded_project_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/family_source"}
      }
    },
    "simion_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solver_id", "recorded_project_id", "source"],
      "properties": {
        "solver_id": {"const": "simion"},
        "recorded_project_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/family_source"}
      }
    },
    "legacy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "particle_count",
        "particle_source_manifest_input_role",
        "manifest",
        "state",
        "particle_source",
        "metadata"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "particle_count": {"const": 100},
        "particle_source_manifest_input_role": {"const": "particle_table"},
        "manifest": {"$ref": "#/$defs/file"},
        "state": {"$ref": "#/$defs/file"},
        "particle_source": {"$ref": "#/$defs/file"},
        "metadata": {"$ref": "#/$defs/file"}
      }
    },
    "family_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "particle_count",
        "particle_source_manifest_input_role",
        "manifest",
        "state",
        "particle_source",
        "metadata"
      ],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "particle_count": {"const": 100},
        "particle_source_manifest_input_role": {"const": "particle_source"},
        "manifest": {"$ref": "#/$defs/file"},
        "state": {"$ref": "#/$defs/file"},
        "particle_source": {"$ref": "#/$defs/file"},
        "metadata": {"$ref": "#/$defs/file"}
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
