{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_runtime_binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "connection_profile_id",
    "upstream_project_id",
    "contracts",
    "implementation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "rf_multipole_oatof_runtime_binding"},
    "integration_id": {"const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"},
    "connection_profile_id": {"$ref": "#/$defs/identifier"},
    "upstream_project_id": {"$ref": "#/$defs/identifier"},
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_contract",
        "pre_pulse_contract",
        "pulse_capture_contract",
        "pulse_timing_contract",
        "handoff_contract",
        "source_contract",
        "upstream_resolved_design"
      ],
      "properties": {
        "dependency_contract": {"$ref": "#/$defs/file"},
        "pre_pulse_contract": {"$ref": "#/$defs/file"},
        "pulse_capture_contract": {"$ref": "#/$defs/file"},
        "pulse_timing_contract": {"$ref": "#/$defs/file"},
        "handoff_contract": {"$ref": "#/$defs/file"},
        "source_contract": {"$ref": "#/$defs/file"},
        "upstream_resolved_design": {"$ref": "#/$defs/file"}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_artifact_support",
        "runtime_binding_support",
        "transfer_runner",
        "pre_pulse_runner",
        "pre_pulse_builder",
        "pre_pulse_field_preparer",
        "pre_pulse_field_solver",
        "pulse_capture_runner",
        "pulse_capture_solver",
        "analyzer_transport_runner"
      ],
      "properties": {
        "run_artifact_support": {"$ref": "#/$defs/file"},
        "runtime_binding_support": {"$ref": "#/$defs/file"},
        "transfer_runner": {"$ref": "#/$defs/file"},
        "pre_pulse_runner": {"$ref": "#/$defs/file"},
        "pre_pulse_builder": {"$ref": "#/$defs/file"},
        "pre_pulse_field_preparer": {"$ref": "#/$defs/file"},
        "pre_pulse_field_solver": {"$ref": "#/$defs/file"},
        "pulse_capture_runner": {"$ref": "#/$defs/file"},
        "pulse_capture_solver": {"$ref": "#/$defs/file"},
        "analyzer_transport_runner": {"$ref": "#/$defs/file"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
