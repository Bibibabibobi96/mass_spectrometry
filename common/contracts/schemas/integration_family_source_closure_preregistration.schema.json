{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_family_source_closure_preregistration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "preregistered_before_run",
    "execution_status",
    "engineering_budget",
    "profiles",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_family_source_closure_preregistration"},
    "integration_id": {
      "const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"
    },
    "preregistered_before_run": {"const": true},
    "execution_status": {"const": "NOT_RUN"},
    "engineering_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "REQUIRED_BEFORE_SOLVER_EXECUTION"}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_profile_id",
          "source_contract",
          "source_branch_ids",
          "particle_count",
          "run_status"
        ],
        "properties": {
          "connection_profile_id": {"$ref": "#/$defs/identifier"},
          "source_contract": {"$ref": "#/$defs/file"},
          "source_branch_ids": {"$ref": "#/$defs/source_branch_ids"},
          "particle_count": {"const": 100},
          "run_status": {"const": "NOT_RUN"}
        }
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source_branch_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "comsol"},
        {"const": "simion"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
