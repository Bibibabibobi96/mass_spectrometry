{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simion_batch_continuation.schema.json",
  "title": "Immutable shared SIMION continuation plans",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "status", "predecessor", "units", "reusable_unit_count", "replay_unit_count"],
  "properties": {
    "schema_version": {"const": 2},
    "role": {"const": "simion_whole_unit_replay_plan"},
    "status": {"const": "ready"},
    "predecessor": {"$ref": "#/$defs/predecessor"},
    "units": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "action", "terminal_outputs"], "properties": {"key": {"type": "string", "minLength": 1}, "action": {"enum": ["reuse", "replay"]}, "terminal_outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}}},
    "reusable_unit_count": {"type": "integer", "minimum": 0},
    "replay_unit_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "predecessor": {"type": "object", "additionalProperties": false, "required": ["run_dir", "run_id", "manifest_sha256", "run_config_sha256"], "properties": {"run_dir": {"type": "string", "minLength": 1}, "run_id": {}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "run_config_sha256": {"$ref": "#/$defs/sha"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
