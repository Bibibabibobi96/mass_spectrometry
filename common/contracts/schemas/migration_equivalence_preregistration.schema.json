{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/migration_equivalence_preregistration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "equivalence_status",
    "execution_status",
    "legacy_oracle",
    "engineering_budget",
    "comparison_requirements",
    "profiles",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_migration_equivalence_preregistration"},
    "integration_id": {"$ref": "#/$defs/identifier"},
    "equivalence_status": {"const": "BLOCKED"},
    "execution_status": {"const": "NOT_RUN"},
    "legacy_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "access"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "access": {"const": "read_only"}
      }
    },
    "engineering_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "status": {"const": "REQUIRED_BEFORE_SOLVER_EXECUTION"}
      }
    },
    "comparison_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_source_population",
        "same_connection_profile",
        "new_entrypoint_rerun_required",
        "source_identity_fields",
        "exact_census",
        "exact_particle_event_sets",
        "continuous_state"
      ],
      "properties": {
        "same_source_population": {"const": true},
        "same_connection_profile": {"const": true},
        "new_entrypoint_rerun_required": {"const": true},
        "source_identity_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "exact_census": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "exact_particle_event_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "legacy_result",
              "new_result",
              "identity_fields"
            ],
            "properties": {
              "phase": {"$ref": "#/$defs/identifier"},
              "legacy_result": {"$ref": "#/$defs/identifier"},
              "new_result": {"type": "string", "minLength": 1},
              "identity_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "continuous_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "fields",
            "reason",
            "blocks_functional_migration_equivalence",
            "claim_limit"
          ],
          "properties": {
            "status": {"const": "NOT_EVALUATED"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "reason": {"type": "string", "minLength": 1},
            "blocks_functional_migration_equivalence": {"const": false},
            "claim_limit": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_profile_id",
          "new_run_status",
          "equivalence_decision"
        ],
        "properties": {
          "connection_profile_id": {"$ref": "#/$defs/identifier"},
          "new_run_status": {"const": "NOT_RUN"},
          "equivalence_decision": {"const": "NOT_RUN"}
        }
      }
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
