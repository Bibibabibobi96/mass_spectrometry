{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_oatof_three_zone_n1_solver_authorization_receipt.schema.json",
  "title": "oaTOF three-zone N=1 solver authorization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role", "gate_id", "decision", "authorization_status",
    "campaign", "producer", "authorized_successor", "identities", "evidence",
    "failure_codes", "claim_limit", "formal_gate_passed"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "role": {"const": "rf_oatof_three_zone_n1_solver_authorization_receipt"},
    "gate_id": {"$ref": "#/$defs/id"},
    "decision": {"enum": ["PASS", "FAIL"]},
    "authorization_status": {
      "enum": [
        "N100_SOLVER_AUTHORIZED", "N100_SOLVER_NOT_AUTHORIZED",
        "SOLVER_AUTHORIZED", "SOLVER_NOT_AUTHORIZED"
      ]
    },
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "campaign_sha256"],
      "properties": {
        "campaign_id": {"$ref": "#/$defs/id"},
        "campaign_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": [
        "experiment_id", "experiment_row_sha256", "integration_run_id",
        "transport_run_id", "transport_manifest"
      ],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/id"},
        "experiment_row_sha256": {"$ref": "#/$defs/sha"},
        "integration_run_id": {"type": "string", "minLength": 1},
        "transport_run_id": {"type": "string", "minLength": 1},
        "transport_manifest": {"$ref": "#/$defs/file"}
      }
    },
    "authorized_successor": {
      "type": "object", "additionalProperties": false,
      "required": ["experiment_id", "experiment_row_sha256", "particle_count"],
      "properties": {
        "experiment_id": {"$ref": "#/$defs/id"},
        "experiment_row_sha256": {"$ref": "#/$defs/sha"},
        "particle_count": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "identities": {
      "type": "object", "additionalProperties": false,
      "required": [
        "candidate_sha256", "layout_profile_id", "architecture_generation_id",
        "topology_id", "geometry_id", "frontend_electrode_topology_id",
        "accelerator_field_profile_id", "field_id",
        "resolved_region_field_semantic_sha256", "source_identity_sha256"
      ],
      "properties": {
        "candidate_sha256": {"$ref": "#/$defs/sha"},
        "layout_profile_id": {"$ref": "#/$defs/id"},
        "architecture_generation_id": {"$ref": "#/$defs/id"},
        "topology_id": {"$ref": "#/$defs/id"},
        "geometry_id": {"$ref": "#/$defs/id"},
        "frontend_electrode_topology_id": {"$ref": "#/$defs/id"},
        "accelerator_field_profile_id": {"$ref": "#/$defs/id"},
        "field_id": {"$ref": "#/$defs/id"},
        "resolved_region_field_semantic_sha256": {"$ref": "#/$defs/sha"},
        "source_identity_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "summary", "checkpoints", "particle_id", "census",
        "required_event_sequence"
      ],
      "properties": {
        "summary": {"$ref": "#/$defs/file"},
        "checkpoints": {"$ref": "#/$defs/file"},
        "particle_id": {"type": "integer", "minimum": 1},
        "census": {
          "type": "object", "additionalProperties": false,
          "required": [
            "launched", "accelerator_grid1_forward",
            "accelerator_intermediate2_forward", "local_accelerator_exit",
            "reflectron_entrance_forward", "reflectron_turning_point",
            "reflectron_exit_return", "detector_crossing"
          ],
          "properties": {
            "launched": {"type": "integer", "minimum": 0},
            "accelerator_grid1_forward": {"type": "integer", "minimum": 0},
            "accelerator_intermediate2_forward": {"type": "integer", "minimum": 0},
            "local_accelerator_exit": {"type": "integer", "minimum": 0},
            "reflectron_entrance_forward": {"type": "integer", "minimum": 0},
            "reflectron_turning_point": {"type": "integer", "minimum": 0},
            "reflectron_exit_return": {"type": "integer", "minimum": 0},
            "detector_crossing": {"type": "integer", "minimum": 0}
          }
        },
        "required_event_sequence": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "prefixItems": [
            {"const": "source_release"}, {"const": "pre_pulse_state"},
            {"const": "accelerator_grid1_forward"},
            {"const": "accelerator_intermediate2_forward"},
            {"const": "local_accelerator_exit"},
            {"const": "reflectron_entrance_forward"},
            {"const": "reflectron_turning_point"},
            {"const": "reflectron_exit_return"}, {"const": "detector_crossing"}
          ],
          "items": false
        }
      }
    },
    "failure_codes": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": [
        "SUMMARY_IDENTITY", "PARTICLE_CENSUS", "PARTICLE_IDENTITY",
        "MISSING_EVENT", "DUPLICATE_EVENT", "NONFINITE_STATE",
        "EVENT_ORDER", "DETECTOR_STATUS"
      ]}
    },
    "claim_limit": {"type": "string", "minLength": 1},
    "formal_gate_passed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "authorized_successor": {"properties": {"particle_count": {"const": 100}}}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "PASS"}}, "required": ["decision"]},
      "then": {
        "allOf": [
          {
            "if": {"properties": {"schema_version": {"const": 1}}, "required": ["schema_version"]},
            "then": {"properties": {"authorization_status": {"const": "N100_SOLVER_AUTHORIZED"}}},
            "else": {"properties": {"authorization_status": {"const": "SOLVER_AUTHORIZED"}}}
          },
          {"properties": {
          "failure_codes": {"maxItems": 0},
          "evidence": {"properties": {"census": {"properties": {
            "launched": {"const": 1},
            "accelerator_grid1_forward": {"const": 1},
            "accelerator_intermediate2_forward": {"const": 1},
            "local_accelerator_exit": {"const": 1},
            "reflectron_entrance_forward": {"const": 1},
            "reflectron_turning_point": {"const": 1},
            "reflectron_exit_return": {"const": 1},
            "detector_crossing": {"const": 1}
          }}}}
          }}
        ]
      },
      "else": {
        "allOf": [
          {
            "if": {"properties": {"schema_version": {"const": 1}}, "required": ["schema_version"]},
            "then": {"properties": {"authorization_status": {"const": "N100_SOLVER_NOT_AUTHORIZED"}}},
            "else": {"properties": {"authorization_status": {"const": "SOLVER_NOT_AUTHORIZED"}}}
          },
          {"properties": {"failure_codes": {"minItems": 1}}}
        ]
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
