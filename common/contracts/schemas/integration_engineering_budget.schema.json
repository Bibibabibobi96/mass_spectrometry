{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_engineering_budget.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "contract_id",
    "preregistered_before_run",
    "pilot_authorization",
    "full_matrix_authorization",
    "budget_exhaustion_result",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_engineering_budget_contract"},
    "integration_id": {"$ref": "#/$defs/identifier"},
    "contract_id": {"$ref": "#/$defs/identifier"},
    "preregistered_before_run": {"const": true},
    "pilot_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "scope", "stage_limits"],
      "properties": {
        "authorized": {"type": "boolean"},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection_profile_ids",
            "source_identity",
            "particle_count",
            "retention_class"
          ],
          "properties": {
            "connection_profile_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/identifier"}
            },
            "source_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project_id",
                "run_id",
                "manifest_sha256",
                "event_sha256",
                "metadata_sha256"
              ],
              "properties": {
                "project_id": {"$ref": "#/$defs/identifier"},
                "run_id": {"type": "string", "minLength": 1},
                "manifest_sha256": {"$ref": "#/$defs/sha256"},
                "event_sha256": {"$ref": "#/$defs/sha256"},
                "metadata_sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "particle_count": {"type": "integer", "minimum": 1},
            "retention_class": {"const": "compact"}
          }
        },
        "stage_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_pulse_interface_transport",
            "pulse_capture",
            "analyzer_transport"
          ],
          "properties": {
            "pre_pulse_interface_transport": {"$ref": "#/$defs/stage"},
            "pulse_capture": {"$ref": "#/$defs/stage"},
            "analyzer_transport": {"$ref": "#/$defs/stage"}
          }
        }
      }
    },
    "full_matrix_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "reason"],
      "properties": {
        "authorized": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "budget_exhaustion_result": {
      "const": "INCONCLUSIVE_RESOURCE_BUDGET_EXCEEDED"
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver",
        "wall_clock_seconds",
        "transient_run_directory_bytes",
        "process_tree_working_set_bytes",
        "minimum_system_available_memory_bytes",
        "compact_final_retained_bytes",
        "automatic_retry_count"
      ],
      "properties": {
        "solver": {"enum": ["comsol", "simion"]},
        "wall_clock_seconds": {"type": "integer", "minimum": 1},
        "transient_run_directory_bytes": {"type": "integer", "minimum": 1},
        "process_tree_working_set_bytes": {"type": "integer", "minimum": 1},
        "minimum_system_available_memory_bytes": {"type": "integer", "minimum": 1},
        "compact_final_retained_bytes": {"type": "integer", "minimum": 1},
        "automatic_retry_count": {"const": 0}
      }
    }
  }
}
