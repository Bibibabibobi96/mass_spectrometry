{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/rf_multipole_oatof_experiment_campaign.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "campaign_id", "status", "execution_policy", "claim_limit", "experiments"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4, 5, 6]},
    "role": {"const": "rf_multipole_oatof_experiment_campaign"},
    "integration_id": {"const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["authorized", "PENDING_PREREGISTRATION", "archived_invalid"]},
    "execution_policy": {"$ref": "#/$defs/file"},
    "claim_limit": {"type": "string", "minLength": 1},
    "preregistration": {"$ref": "#/$defs/preregistration"},
    "pulse_resolution_optimization": {"$ref": "#/$defs/pulse_resolution_optimization"},
    "pulse_resolution_cohort_authority": {"$ref": "#/$defs/pulse_resolution_cohort_authority"},
    "pulse_resolution_baseline_evidence": {"$ref": "#/$defs/baseline_evidence"},
    "experiments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/experiment"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": [2, 3, 4, 5, 6]}}, "required": ["schema_version"]},
      "then": {"properties": {"experiments": {"items": {"required": ["single_flight_layout_profile_id"]}}}},
      "else": {"properties": {"experiments": {"items": {"not": {"required": ["single_flight_layout_profile_id"]}}}}}
    },
    {
      "if": {"required": ["pulse_resolution_optimization"]},
      "then": {"properties": {"schema_version": {"enum": [2, 3, 4, 5, 6]}}}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": 5}},
        "required": ["schema_version", "pulse_resolution_optimization"]
      },
      "then": {
        "required": ["pulse_resolution_cohort_authority"],
        "properties": {
          "experiments": {"items": {"not": {"anyOf": [
            {"required": ["pulse_resolution_baseline_result"]},
            {"required": ["pulse_resolution_baseline_checkpoints"]}
          ]}}}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "PENDING_PREREGISTRATION"}},
        "required": ["status"]
      },
      "then": {
        "not": {"required": ["pulse_resolution_baseline_evidence"]},
        "properties": {"pulse_resolution_optimization": {
          "properties": {"comparison_matrix": {"items": {
            "properties": {"authority_status": {"const": "pending_preregistration"}}
          }}}
        }}
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "authorized"},
          "experiments": {"contains": {"properties": {
            "pulse_resolution_execution_mode": {
              "const": "screening_prefix_n100_paired_candidate"
            }
          }, "required": ["pulse_resolution_execution_mode"]}}
        },
        "required": ["status", "experiments"]
      },
      "then": {
        "required": ["preregistration", "pulse_resolution_baseline_evidence"],
        "properties": {"pulse_resolution_optimization": {
          "properties": {"comparison_matrix": {"items": {
            "properties": {"authority_status": {"const": "direct_executable_contract"}}
          }}}
        }}
      }
    },
    {
      "if": {"properties": {"schema_version": {"enum": [3, 4, 5]}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "experiments": {
            "items": {
              "required": ["execution_strategy"],
              "allOf": [
                {
                  "if": {
                    "properties": {"execution_strategy": {"const": "simion_single_flight"}},
                    "required": ["execution_strategy"]
                  },
                  "then": {
                    "required": [
                      "single_flight_layout_profile_id",
                      "architecture_generation_id",
                      "source_profile_id",
                      "field_overlay_id",
                      "source_release_mode",
                      "single_flight_population"
                    ],
                    "allOf": [
                      {"not": {"required": ["single_flight_pulse_offset_rf_periods"]}},
                      {
                        "if": {
                          "properties": {"source_release_mode": {"const": "staged_grid2_restart"}},
                          "required": ["source_release_mode"]
                        },
                        "then": {"not": {"required": ["single_flight_pulse_schedule_policy"]}},
                        "else": {"required": ["single_flight_pulse_schedule_policy"]}
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"enum": [4, 5]}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "experiments": {
            "items": {
              "if": {
                "properties": {"execution_strategy": {"const": "simion_single_flight"}},
                "required": ["execution_strategy"]
              },
              "then": {"required": ["single_flight_pa_cache_policy"]},
              "else": {"not": {"required": ["single_flight_pa_cache_policy"]}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 5}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "experiments": {
            "items": {
              "if": {
                "properties": {"source_release_mode": {"const": "staged_grid2_restart"}},
                "required": ["source_release_mode"]
              },
              "then": {
                "properties": {
                  "staged_grid2_source_state": {"required": ["loader_authorization_budget"]}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "experiments": {
            "contains": {
              "properties": {
                "staged_grid2_source_state": {
                  "required": ["loader_authorization_budget"]
                }
              },
              "required": ["staged_grid2_source_state"]
            }
          }
        },
        "required": ["experiments"]
      },
      "then": {
        "properties": {
          "schema_version": {"const": 5},
          "experiments": {
            "items": {
              "if": {
                "properties": {
                  "staged_grid2_source_state": {
                    "required": ["loader_authorization_budget"]
                  }
                },
                "required": ["staged_grid2_source_state"]
              },
              "then": {
                "properties": {
                  "source_release_mode": {"const": "staged_grid2_restart"}
                },
                "required": ["source_release_mode"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "sha": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "baseline_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id", "baseline_campaign_id", "baseline_campaign_sha256",
        "path", "sha256"
      ],
      "properties": {
        "authority_id": {"$ref": "#/$defs/id"},
        "baseline_campaign_id": {"$ref": "#/$defs/id"},
        "baseline_campaign_sha256": {"$ref": "#/$defs/sha"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "preregistration": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "document", "frozen_experiment_row_sha256"],
      "properties": {
        "status": {"const": "REGISTERED_EXECUTION_REQUIRES_EXPLICIT_AUTHORIZATION"},
        "document": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "bytes": {"type": "integer", "minimum": 1},
            "sha256": {"$ref": "#/$defs/sha"}
          }
        },
        "frozen_experiment_row_sha256": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha"}
        }
      }
    },
    "versioned_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_revision", "path", "sha256", "supersedes"],
      "properties": {
        "evidence_revision": {"type": "integer", "minimum": 2},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "supersedes": {"$ref": "#/$defs/file"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "launched_particle_count", "particle_count", "particle_source_manifest_input_role", "manifest", "state", "particle_source", "metadata"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "launched_particle_count": {"type": "integer", "enum": [100, 1000]},
        "particle_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "particle_source_manifest_input_role": {"type": "string", "minLength": 1},
        "manifest": {"$ref": "#/$defs/file"}, "state": {"$ref": "#/$defs/file"},
        "particle_source": {"$ref": "#/$defs/file"}, "metadata": {"$ref": "#/$defs/file"},
        "handoff_publication_contract": {"$ref": "#/$defs/file"},
        "authority_scope": {"enum": ["source_population", "connection_lineage_only"]}
      }
    },
    "single_flight_particle_source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "particle_count", "sampling_mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "particle_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "sampling_mode": {"enum": ["steady_candidate_pool", "continuous_injection_full_population", "pulse_eligible_conditional"]},
        "selection_receipt": {"$ref": "#/$defs/file"}
      }
    },
    "pre_pulse_source_state": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "particle_count", "coordinate_frame", "release_event"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "particle_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "coordinate_frame": {"const": "oatof_global_cartesian"},
        "release_event": {"const": "pre_pulse_state"},
        "materialization_receipt": {"$ref": "#/$defs/file"},
        "source_state_epoch": {"const": "pulse_effective_time"},
        "source_state_locus": {"const": "accelerator_stage1_interior_fixed_transverse_finite_local_z_interval"},
        "position_rowwise_abs_tolerance_mm": {"const": 1e-9},
        "velocity_rowwise_abs_tolerance_m_per_s": {"const": 1e-6},
        "clock_abs_tolerance_us": {"const": 1e-9},
        "energy_abs_tolerance_eV": {"const": 5e-9},
        "postselection_prohibited": {"const": true}
      }
    },
    "generated_pre_pulse_ordered_subset": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_id"],
      "properties": {
        "selection_id": {
          "enum": [
            "n1_center_source_id_500_v1",
            "n100_file_order_source_ids_1_to_100_v1",
            "n100_uniform_full_width_source_ids_1_to_1000_v1"
          ]
        }
      }
    },
    "three_zone_solver_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate_id", "stage"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["n1_smoke_producer", "n100_solver_authorized_consumer"]},
        "predecessor_experiment_id": {"$ref": "#/$defs/id"}
      },
      "allOf": [{
        "if": {"properties": {"stage": {"const": "n100_solver_authorized_consumer"}}, "required": ["stage"]},
        "then": {"required": ["predecessor_experiment_id"]},
        "else": {"not": {"required": ["predecessor_experiment_id"]}}
      }]
    },
    "staged_grid2_source_state": {
      "type": "object", "additionalProperties": false,
      "required": [
        "path", "sha256", "particle_count", "schema_id", "state_event",
        "frame_id", "clock_basis", "clock_epoch_id", "simion_start_instance",
        "position_projection_applied", "producer_run_id", "producer_manifest"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "particle_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "schema_id": {"const": "canonical_component_particle_state_v1"},
        "state_event": {"const": "local_accelerator_exit"},
        "frame_id": {"const": "oatof_global"},
        "clock_basis": {"const": "canonical_instrument_time_us"},
        "clock_epoch_id": {"type": "string", "minLength": 1},
        "simion_start_instance": {"enum": [3, 5]},
        "position_projection_applied": {"const": false},
        "producer_run_id": {"type": "string", "minLength": 1},
        "producer_manifest": {"$ref": "#/$defs/file"},
        "loader_authorization_budget": {"$ref": "#/$defs/file"},
        "legacy_bridge": {
          "type": "object", "additionalProperties": false,
          "required": ["template", "trace", "receipt_characterization"],
          "properties": {
            "template": {"$ref": "#/$defs/file"},
            "trace": {"$ref": "#/$defs/file"},
            "receipt_characterization": {"$ref": "#/$defs/file"}
          }
        }
      }
    },
    "single_flight_pulse_schedule_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "offset_rf_periods", "pulse_width_us"],
      "properties": {
        "policy_id": {"const": "multipole_handoff_ballistic_centroid_v1"},
        "offset_rf_periods": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "pulse_width_us": {"type": "number", "exclusiveMinimum": 0},
        "fixed_execution_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_mode", "pulse_effective_time_us", "rf_period_us",
            "source_schedule", "source_state_sha256"
          ],
          "properties": {
            "authority_mode": {"const": "frozen_historical_schedule_v1"},
            "pulse_effective_time_us": {"type": "number", "minimum": 0},
            "rf_period_us": {"type": "number", "exclusiveMinimum": 0},
            "source_schedule": {"$ref": "#/$defs/file"},
            "source_state_sha256": {"$ref": "#/$defs/sha"}
          }
        }
      }
    },
    "single_flight_population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population_id", "population_mode", "source_authority",
        "execution_population", "analysis_randomness",
        "postselection_policy"
      ],
      "properties": {
        "population_id": {"$ref": "#/$defs/id"},
        "population_mode": {
          "enum": [
            "staged_three_stage",
            "continuous_injection_full_population",
            "resolved_layout_pulse_ideal_linear_z_vz",
            "pre_pulse_restart",
            "staged_grid2_restart",
            "pulse_eligible_conditional",
            "first_100_rows_in_frozen_file_order"
          ]
        },
        "source_authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_role", "table_binding", "ordered_particle_id_encoding"],
          "properties": {
            "input_role": {"type": "string", "minLength": 1},
            "table_binding": {
              "enum": [
                "source_contract_particle_source",
                "experiment_single_flight_particle_source",
                "experiment_pre_pulse_source_state",
                "experiment_staged_grid2_source_state",
                "prepared_materialized_particle_source",
                "prepared_deterministic_prefix",
                "staged_upstream_source"
              ]
            },
            "ordered_particle_id_encoding": {"const": "canonical_compact_json_integer_array_v1"}
          }
        },
        "execution_population": {
          "type": "object",
          "additionalProperties": false,
          "required": ["particle_count", "ordered_particle_id_sha256", "selection_algorithm", "selection_seed"],
          "properties": {
            "particle_count": {"type": "integer", "minimum": 1, "maximum": 10000},
            "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"},
            "selection_algorithm": {"type": "string", "minLength": 1},
            "selection_seed": {"type": "integer", "minimum": 0}
          }
        },
        "denominators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population_count", "eligible_population_count"],
          "properties": {
            "population_count": {"type": "integer", "minimum": 1, "maximum": 10000},
            "eligible_population_count": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "analysis_randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bootstrap_resample_count", "bootstrap_seed"],
          "properties": {
            "bootstrap_resample_count": {"type": "integer", "minimum": 0},
            "bootstrap_seed": {"type": "integer", "minimum": 0}
          }
        },
        "postselection_policy": {
          "enum": ["prohibited", "detector_blind_preregistered", "pulse_eligibility_only"]
        }
      }
    },
    "pulse_resolution_cohort_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "checkpoint", "source_release", "pre_pulse_state",
        "pulse_eligible", "outside_transverse_bore",
        "observed_eligibility_policy", "detector_survivor_reselection"
      ],
      "properties": {
        "role": {"enum": ["rf_oatof_frozen_paired_cohort_authority", "rf_oatof_historical_migration_reference"]},
        "checkpoint": {"$ref": "#/$defs/file"},
        "source_release": {
          "allOf": [
            {"$ref": "#/$defs/frozen_cohort_selector"},
            {"properties": {"selector": {"const": "event == source_release"}}}
          ]
        },
        "pre_pulse_state": {
          "allOf": [
            {"$ref": "#/$defs/frozen_cohort_selector"},
            {"properties": {"selector": {"const": "event == pre_pulse_state"}}}
          ]
        },
        "pulse_eligible": {
          "allOf": [
            {"$ref": "#/$defs/frozen_cohort_selector"},
            {"properties": {"selector": {"const": "event == pre_pulse_state and pulse_eligibility == eligible"}}}
          ]
        },
        "outside_transverse_bore": {
          "allOf": [
            {"$ref": "#/$defs/frozen_cohort_selector"},
            {"properties": {"selector": {"const": "event == pre_pulse_state and pulse_eligibility == outside_transverse_bore"}}}
          ]
        },
        "observed_eligibility_policy": {"const": "exact_count_and_ordered_id_sha_fail_closed"},
        "detector_survivor_reselection": {"const": "prohibited"}
      }
    },
    "frozen_cohort_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "ordered_particle_id_sha256"],
      "properties": {
        "selector": {"type": "string", "minLength": 1},
        "ordered_particle_id_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "pulse_resolution_optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose", "execution_state", "clock_contract", "population_contract",
        "stage_order", "comparison_matrix", "screening_promotion", "grid_convergence",
        "optimization_constraints", "acceptance_window", "acceptance_gates",
        "comsol_handoff"
      ],
      "properties": {
        "purpose": {"const": "physical_optimization"},
        "execution_state": {"enum": ["n100_baseline_registration_only", "n100_full_domain_piecewise_ideal_field_screening"]},
        "clock_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["resolution_time_basis", "absolute_instrument_clock_is_resolution_claim"],
          "properties": {
            "resolution_time_basis": {"const": "detector_time_minus_pulse_effective_time"},
            "absolute_instrument_clock_is_resolution_claim": {"const": false}
          }
        },
        "population_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["mother_sample_count", "screening_prefix_count", "screening_is_deterministic_prefix", "qualification_population", "random_downsampling_allowed", "parallel_batch_count"],
          "properties": {
            "mother_sample_count": {"const": 1000},
            "screening_prefix_count": {"const": 100},
            "screening_is_deterministic_prefix": {"const": true},
            "qualification_population": {"const": "all_pulse_eligible_particles"},
            "random_downsampling_allowed": {"const": false},
            "parallel_batch_count": {"const": 5}
          }
        },
        "stage_order": {
          "type": "array", "prefixItems": [
            {"const": "implementation_and_observability"},
            {"const": "ideal_upper_bound_attribution"},
            {"const": "local_grid_convergence"},
            {"const": "joint_optimization"},
            {"const": "detector_blind_acceptance_window"},
            {"const": "simion_qualification"},
            {"const": "comsol_handoff"}
          ], "items": false, "minItems": 7, "maxItems": 7
        },
        "comparison_matrix": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sequence", "experiment_id", "source_profile_id", "field_profile_id", "authority_status"],
            "properties": {
              "sequence": {"type": "integer", "minimum": 1, "maximum": 8},
              "experiment_id": {"$ref": "#/$defs/id"},
              "source_profile_id": {"$ref": "#/$defs/id"},
              "field_profile_id": {"$ref": "#/$defs/id"},
              "authority_status": {"enum": ["direct_executable_contract", "pending_preregistration", "planning_only_until_direct_contract"]}
            }
          }
        },
        "screening_promotion": {
          "type": "object", "additionalProperties": false,
          "required": ["unimodal_required", "direct_fwhm_relative_improvement_minimum", "sigma_relative_improvement_minimum", "both_improvements_required", "axial_ideal_closure_experiment_id", "axial_ideal_minimum_mass_resolution", "axial_ideal_failure_action"],
          "properties": {
            "unimodal_required": {"const": true},
            "direct_fwhm_relative_improvement_minimum": {"const": 0.15},
            "sigma_relative_improvement_minimum": {"const": 0.15},
            "both_improvements_required": {"const": true},
            "axial_ideal_closure_experiment_id": {"$ref": "#/$defs/id"},
            "axial_ideal_minimum_mass_resolution": {"const": 30000},
            "axial_ideal_failure_action": {"const": "stop_physical_optimization_and_repair_clock_ideal_field_or_theory"}
          }
        },
        "grid_convergence": {
          "type": "object", "additionalProperties": false,
          "required": ["mass_resolution_relative_change_maximum", "direct_fwhm_relative_change_maximum", "hit_rate_change_maximum_percentage_points", "refine_only_attributed_limiting_regions"],
          "properties": {
            "mass_resolution_relative_change_maximum": {"const": 0.02},
            "direct_fwhm_relative_change_maximum": {"const": 0.02},
            "hit_rate_change_maximum_percentage_points": {"const": 1.0},
            "refine_only_attributed_limiting_regions": {"const": true}
          }
        },
        "optimization_constraints": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_count_maximum", "cartesian_blind_scan_allowed", "derived_variables_prohibited", "diagnostic_variables_are_physical_optima", "external_instrument_radius_increase_allowed", "focus_global_z_mm", "reflectron_minimum_electrode_gap_mm"],
          "properties": {
            "candidate_count_maximum": {"const": 5},
            "cartesian_blind_scan_allowed": {"const": false},
            "derived_variables_prohibited": {
              "type": "array", "minItems": 5, "uniqueItems": true,
              "items": {"enum": ["absolute_electrode_voltages", "focus_plane", "source_center", "reflectron_endpoints", "ring_baseline_voltages", "shield_position"]}
            },
            "diagnostic_variables_are_physical_optima": {"const": false},
            "external_instrument_radius_increase_allowed": {"const": false},
            "focus_global_z_mm": {"const": 0.0},
            "reflectron_minimum_electrode_gap_mm": {"minimum": 1.0}
          }
        },
        "acceptance_window": {
          "type": "object", "additionalProperties": false,
          "required": ["derivation", "selection_uses_detector_outcome", "center_binding", "allowed_coordinates", "tof_error_budget_ns", "minimum_pulse_eligible_coverage", "shrink_below_minimum_coverage_allowed", "freeze_before_real_beam_application", "outside_window_remains_in_full_beam"],
          "properties": {
            "derivation": {"const": "synthetic_phase_space_and_real_minus_ideal_field_error_budget"},
            "selection_uses_detector_outcome": {"const": false},
            "center_binding": {"const": "theory_source_center"},
            "allowed_coordinates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["x", "y", "z", "angle_x", "angle_y"]}},
            "tof_error_budget_ns": {"const": 0.537},
            "minimum_pulse_eligible_coverage": {"const": 0.70},
            "shrink_below_minimum_coverage_allowed": {"const": false},
            "freeze_before_real_beam_application": {"const": true},
            "outside_window_remains_in_full_beam": {"const": true}
          }
        },
        "acceptance_gates": {
          "type": "object", "additionalProperties": false,
          "required": ["full_beam", "theoretical_window"],
          "properties": {
            "full_beam": {"$ref": "#/$defs/resolution_gate"},
            "theoretical_window": {"$ref": "#/$defs/resolution_gate"}
          }
        },
        "comsol_handoff": {
          "type": "object", "additionalProperties": false,
          "required": ["simion_dual_gate_required", "single_solver_session", "global_cartesian_velocity_error_limit_exclusive_m_per_s", "mass_resolution_relative_difference_maximum", "hit_rate_difference_maximum_percentage_points"],
          "properties": {
            "simion_dual_gate_required": {"const": true},
            "single_solver_session": {"const": true},
            "global_cartesian_velocity_error_limit_exclusive_m_per_s": {"const": 0.000001},
            "mass_resolution_relative_difference_maximum": {"const": 0.10},
            "hit_rate_difference_maximum_percentage_points": {"const": 1.0}
          }
        }
      }
    },
    "resolution_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["population_basis", "unimodal_required", "conditional_hit_rate_minimum", "mass_resolution_minimum", "direct_fwhm_maximum_ns"],
      "properties": {
        "population_basis": {"enum": ["all_pulse_eligible_particles", "detector_blind_theoretical_acceptance_window"]},
        "unimodal_required": {"const": true},
        "conditional_hit_rate_minimum": {"const": 0.95},
        "mass_resolution_minimum": {"enum": [20000, 30000]},
        "direct_fwhm_maximum_ns": {"enum": [0.806, 0.537]}
      }
    },
    "experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "experiment_id", "connection_profile_id", "run_id", "source"],
      "allOf": [
        {
          "if": {"required": ["architecture_generation_id"]},
          "then": {"required": ["source_profile_id", "field_overlay_id", "source_release_mode"]}
        },
        {
          "if": {
            "properties": {
              "single_flight_layout_profile_id": {
                "enum": [
                  "three_zone_t5_primary_v1",
                  "three_zone_t5_primary_shaping_rings_1p4_v1"
                ]
              }
            },
            "required": ["single_flight_layout_profile_id"]
          },
          "then": {"required": ["single_flight_three_zone_candidate"]},
          "else": {"not": {"required": ["single_flight_three_zone_candidate"]}}
        },
        {
          "if": {
            "properties": {"source_release_mode": {"const": "pre_pulse_restart"}},
            "required": ["source_release_mode"]
          },
          "then": {
            "required": ["architecture_generation_id", "source_profile_id", "field_overlay_id"],
            "oneOf": [
              {"required": ["pre_pulse_source_state"]},
              {"required": ["generated_pre_pulse_ordered_subset", "single_flight_source_materialization_profile_id"]}
            ]
          }
        },
        {
          "if": {"required": ["pre_pulse_source_state"]},
          "then": {
            "properties": {"source_release_mode": {"const": "pre_pulse_restart"}},
            "required": ["source_release_mode"]
          }
        },
        {
          "if": {"required": ["generated_pre_pulse_ordered_subset"]},
          "then": {
            "properties": {
              "source_release_mode": {"const": "pre_pulse_restart"},
              "source_profile_id": {"const": "canonical_ideal_linear_z_vz_2p2mm_n1000"},
              "single_flight_source_materialization_profile_id": {"const": "canonical_ideal_linear_z_vz_2p2mm_n1000"}
            },
            "required": ["source_release_mode", "single_flight_source_materialization_profile_id"],
            "not": {"required": ["pre_pulse_source_state"]}
          }
        },
        {
          "if": {
            "properties": {
              "generated_pre_pulse_ordered_subset": {
                "properties": {"selection_id": {"const": "n1_center_source_id_500_v1"}},
                "required": ["selection_id"]
              }
            },
            "required": ["generated_pre_pulse_ordered_subset"]
          },
          "then": {
            "properties": {
              "single_flight_population": {
                "properties": {
                  "execution_population": {"properties": {"particle_count": {"const": 1}}},
                  "denominators": {
                    "properties": {
                      "population_count": {"const": 1},
                      "eligible_population_count": {"const": 1}
                    }
                  }
                }
              }
            },
            "required": ["single_flight_population"]
          }
        },
        {
          "if": {
            "properties": {
              "generated_pre_pulse_ordered_subset": {
                "properties": {
                  "selection_id": {
                    "enum": [
                      "n100_file_order_source_ids_1_to_100_v1",
                      "n100_uniform_full_width_source_ids_1_to_1000_v1"
                    ]
                  }
                },
                "required": ["selection_id"]
              }
            },
            "required": ["generated_pre_pulse_ordered_subset"]
          },
          "then": {
            "properties": {
              "single_flight_population": {
                "properties": {
                  "execution_population": {"properties": {"particle_count": {"const": 100}}},
                  "denominators": {
                    "properties": {
                      "population_count": {"const": 100},
                      "eligible_population_count": {"const": 100}
                    }
                  }
                }
              }
            },
            "required": ["single_flight_population"]
          }
        },
        {
          "if": {
            "properties": {"source_release_mode": {"const": "staged_grid2_restart"}},
            "required": ["source_release_mode"]
          },
          "then": {
            "required": ["architecture_generation_id", "source_profile_id", "field_overlay_id", "staged_grid2_source_state"],
            "properties": {
              "source": {"properties": {"authority_scope": {"const": "connection_lineage_only"}}, "required": ["authority_scope"]}
            },
            "allOf": [
              {
                "if": {"properties": {"field_overlay_id": {"const": "none"}}, "required": ["field_overlay_id"]},
                "then": {"properties": {"staged_grid2_source_state": {"properties": {"simion_start_instance": {"const": 3}}}}},
                "else": {"properties": {"staged_grid2_source_state": {"properties": {"simion_start_instance": {"const": 5}}}}}
              },
              {
                "if": {"properties": {"staged_grid2_source_state": {"properties": {"simion_start_instance": {"const": 3}}}}},
                "then": {"properties": {"field_overlay_id": {"const": "none"}}},
                "else": {"properties": {"field_overlay_id": {"not": {"const": "none"}}}}
              }
            ]
          }
        },
        {
          "if": {"required": ["staged_grid2_source_state"]},
          "then": {
            "properties": {"source_release_mode": {"const": "staged_grid2_restart"}},
            "required": ["source_release_mode"]
          }
        },
        {
          "if": {"required": ["single_flight_population"]},
          "then": {
            "oneOf": [
              {
                "properties": {
                  "execution_strategy": {"const": "staged_three_stage"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "staged_three_stage"},
                    "source_authority": {"properties": {"table_binding": {"const": "staged_upstream_source"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy"],
                "not": {"required": ["source_release_mode"]}
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "continuous_frontend"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "continuous_injection_full_population"},
                    "source_authority": {"properties": {"table_binding": {"const": "source_contract_particle_source"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "continuous_frontend"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "resolved_layout_pulse_ideal_linear_z_vz"},
                    "source_authority": {"properties": {"table_binding": {"const": "prepared_materialized_particle_source"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "pre_pulse_restart"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "pre_pulse_restart"},
                    "source_authority": {"properties": {"table_binding": {"const": "experiment_pre_pulse_source_state"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "staged_grid2_restart"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "staged_grid2_restart"},
                    "source_authority": {"properties": {"table_binding": {"const": "experiment_staged_grid2_source_state"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "continuous_frontend"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "pulse_eligible_conditional"},
                    "source_authority": {"properties": {"table_binding": {"const": "experiment_single_flight_particle_source"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "all_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "pulse_eligibility_only"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              },
              {
                "properties": {
                  "execution_strategy": {"const": "simion_single_flight"},
                  "source_release_mode": {"const": "continuous_frontend"},
                  "single_flight_population": {"properties": {
                    "population_mode": {"const": "first_100_rows_in_frozen_file_order"},
                    "source_authority": {"properties": {"table_binding": {"const": "prepared_deterministic_prefix"}}},
                    "execution_population": {"properties": {"selection_algorithm": {"const": "first_100_rows_in_frozen_file_order"}}},
                    "postselection_policy": {"const": "prohibited"}
                  }}
                },
                "required": ["execution_strategy", "source_release_mode"]
              }
            ]
          }
        }
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "experiment_id": {"$ref": "#/$defs/id"},
        "execution_strategy": {"enum": ["staged_three_stage", "simion_single_flight"]},
        "single_flight_layout_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_frontend_grid_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_oatof_numerical_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_trajectory_quality_profile_id": {"enum": ["tqual_8", "tqual_108"]},
        "single_flight_time_integration_profile_id": {"enum": ["dt160", "dt320"]},
        "single_flight_pa_cache_policy": {
          "enum": ["require_existing", "build_and_publish_if_missing"]
        },
        "single_flight_spatial_window_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_accelerator_field_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_source_materialization_profile_id": {"$ref": "#/$defs/id"},
        "single_flight_three_zone_candidate": {"$ref": "#/$defs/file"},
        "architecture_generation_id": {"$ref": "#/$defs/id"},
        "source_profile_id": {"$ref": "#/$defs/id"},
        "field_overlay_id": {"$ref": "#/$defs/id"},
        "source_release_mode": {"enum": ["continuous_frontend", "pre_pulse_restart", "staged_grid2_restart"]},
        "pre_pulse_source_state": {"$ref": "#/$defs/pre_pulse_source_state"},
        "generated_pre_pulse_ordered_subset": {"$ref": "#/$defs/generated_pre_pulse_ordered_subset"},
        "three_zone_solver_gate": {"$ref": "#/$defs/three_zone_solver_gate"},
        "staged_grid2_source_state": {"$ref": "#/$defs/staged_grid2_source_state"},
        "single_flight_pulse_offset_rf_periods": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "single_flight_pulse_schedule_policy": {"$ref": "#/$defs/single_flight_pulse_schedule_policy"},
        "single_flight_population": {"$ref": "#/$defs/single_flight_population"},
        "pulse_resolution_execution_mode": {"enum": ["screening_prefix_n100_baseline_registration", "screening_prefix_n100_paired_candidate", "qualification_full_n1000"]},
        "pulse_resolution_baseline_result": {"$ref": "#/$defs/file"},
        "pulse_resolution_baseline_checkpoints": {"$ref": "#/$defs/file"},
        "single_flight_design_overrides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable", "value", "unit"],
            "properties": {
              "variable": {"$ref": "#/$defs/id"},
              "value": {"type": "number"},
              "unit": {"type": "string", "minLength": 1}
            }
          }
        },
        "single_flight_design_reference": {"$ref": "#/$defs/source"},
        "single_flight_particle_source": {"$ref": "#/$defs/single_flight_particle_source"},
        "connection_profile_id": {"$ref": "#/$defs/id"},
        "run_id": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
