{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/integration_family_source_closure_budget.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "integration_id",
    "contract_id",
    "preregistered_before_run",
    "authorization",
    "full_matrix_authorization",
    "budget_exhaustion_result",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_family_source_closure_budget"},
    "integration_id": {
      "const": "rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer"
    },
    "contract_id": {"$ref": "#/$defs/identifier"},
    "preregistered_before_run": {"const": true},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "scope", "stage_limits"],
      "properties": {
        "authorized": {"const": true},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_source_contracts",
            "source_branch_ids",
            "particle_count",
            "retention_class"
          ],
          "properties": {
            "profile_source_contracts": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["connection_profile_id", "source_contract"],
                "properties": {
                  "connection_profile_id": {"$ref": "#/$defs/identifier"},
                  "source_contract": {"$ref": "#/$defs/file"}
                }
              }
            },
            "source_branch_ids": {"$ref": "#/$defs/source_branch_ids"},
            "particle_count": {"const": 100},
            "retention_class": {"const": "compact"}
          }
        },
        "stage_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pre_pulse_interface_transport",
            "pulse_capture",
            "analyzer_transport"
          ],
          "properties": {
            "pre_pulse_interface_transport": {
              "$ref": "#/$defs/comsol_stage_limit"
            },
            "pulse_capture": {"$ref": "#/$defs/comsol_stage_limit"},
            "analyzer_transport": {"$ref": "#/$defs/simion_stage_limit"}
          }
        }
      }
    },
    "full_matrix_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "reason"],
      "properties": {
        "authorized": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "budget_exhaustion_result": {
      "const": "INCONCLUSIVE_RESOURCE_BUDGET_EXCEEDED"
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stage_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver",
        "wall_clock_seconds",
        "transient_run_directory_bytes",
        "process_tree_working_set_bytes",
        "minimum_system_available_memory_bytes",
        "compact_final_retained_bytes",
        "automatic_retry_count"
      ],
      "properties": {
        "solver": {"enum": ["comsol", "simion"]},
        "wall_clock_seconds": {"type": "integer", "minimum": 1},
        "transient_run_directory_bytes": {"type": "integer", "minimum": 1},
        "process_tree_working_set_bytes": {"type": "integer", "minimum": 1},
        "minimum_system_available_memory_bytes": {"type": "integer", "minimum": 1},
        "compact_final_retained_bytes": {"type": "integer", "minimum": 1},
        "automatic_retry_count": {"const": 0}
      }
    },
    "comsol_stage_limit": {
      "allOf": [
        {"$ref": "#/$defs/stage_limit"},
        {"properties": {"solver": {"const": "comsol"}}}
      ]
    },
    "simion_stage_limit": {
      "allOf": [
        {"$ref": "#/$defs/stage_limit"},
        {"properties": {"solver": {"const": "simion"}}}
      ]
    },
    "source_branch_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "comsol"},
        {"const": "simion"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
