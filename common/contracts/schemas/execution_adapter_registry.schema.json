{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/execution_adapter_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "mappings"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "integration_execution_adapter_registry"},
    "integration_id": {"$ref": "#/$defs/identifier"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_profile_id",
          "adapter_entrypoint",
          "adapter_sha256",
          "runtime_binding_path",
          "runtime_binding_sha256"
        ],
        "properties": {
          "connection_profile_id": {"$ref": "#/$defs/identifier"},
          "adapter_entrypoint": {"$ref": "#/$defs/path"},
          "adapter_sha256": {"$ref": "#/$defs/sha256"},
          "runtime_binding_path": {"$ref": "#/$defs/path"},
          "runtime_binding_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}
