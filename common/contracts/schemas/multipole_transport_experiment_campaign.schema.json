{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/multipole_transport_experiment_campaign.schema.json",
  "title": "Declarative SIMION multipole transport experiment campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "family_id",
    "campaign_id",
    "preregistered_before_run",
    "experiments",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": 7},
    "role": {"const": "multipole_transport_experiment_campaign"},
    "family_id": {"const": "rf_multipole_ion_optics"},
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "preregistered_before_run": {"const": true},
    "design_variable_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_variable_ids", "variable_limits"],
      "properties": {
        "allowed_variable_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["rf_amplitude", "rf_frequency", "rf_phase", "common_mode_offset", "segment_entrance_common_mode", "segment_exit_common_mode", "segment_output_reference"]}
        },
        "variable_limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable_id", "unit", "minimum", "maximum"],
            "properties": {
              "variable_id": {"enum": ["rf_amplitude", "rf_frequency", "rf_phase", "common_mode_offset", "segment_entrance_common_mode", "segment_exit_common_mode", "segment_output_reference"]},
              "unit": {"enum": ["V", "Hz", "rad"]},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"}
            }
          }
        }
      }
    },
    "analysis_requests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/analysis_request"}
    },
    "particle_source_phase_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "baseline_frequency_Hz",
        "frequency_variable_id",
        "n1000_reference_profile_id"
      ],
      "properties": {
        "kind": {"const": "match_baseline_rf_phase"},
        "baseline_frequency_Hz": {"type": "number", "exclusiveMinimum": 0},
        "frequency_variable_id": {"const": "rf_frequency"},
        "n1000_reference_profile_id": {"type": "string", "minLength": 1},
        "n1000_authority_relationship": {
          "enum": [
            "same_as_reference",
            "source_model_comparison_with_same_particle_ids"
          ]
        }
      }
    },
    "particle_source_transform_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rf_frequency_Hz", "n1000_reference_profile_id"],
      "properties": {
        "kind": {"const": "preserve_phase_position_direction_and_scale_energy"},
        "rf_frequency_Hz": {"type": "number", "exclusiveMinimum": 0},
        "n1000_reference_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "simion_pa_basis_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reuse_scope"],
      "properties": {
        "kind": {"const": "content_addressed_geometry_basis"},
        "reuse_scope": {"const": "same_project_same_fingerprint"},
        "require_existing": {"type": "boolean"}
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/experiment"}
    },
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"required": ["design_variable_authorization"]},
      "then": {"properties": {"experiments": {"items": {
        "required": ["execution_profile_id", "design_variable_values"]
      }}}},
      "else": {"properties": {"experiments": {"items": {"not": {"anyOf": [
        {"required": ["execution_profile_id"]},
        {"required": ["design_variable_values"]}
      ]}}}}}
    },
    {
      "if": {"required": ["particle_source_phase_policy"]},
      "then": {
        "required": ["design_variable_authorization"],
        "not": {"required": ["particle_source_transform_policy"]}
      }
    },
    {
      "if": {"required": ["particle_source_transform_policy"]},
      "then": {
        "required": ["simion_pa_basis_policy"],
        "properties": {"experiments": {"items": {"required": ["source_kinetic_energy_eV"]}}}
      },
      "else": {"properties": {"experiments": {"items": {"not": {"required": ["source_kinetic_energy_eV"]}}}}}
    },
    {
      "if": {"required": ["analysis_requests"]},
      "then": {"properties": {"experiments": {"items": {"required": ["case_set"]}}}}
    }
  ],
  "$defs": {
    "analysis_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "experiment_ids",
        "baseline_experiment_id",
        "analysis_run_id",
        "parameters"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "experiment_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "baseline_experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "analysis_run_id": {
          "type": "string",
          "pattern": "^[0-9]{8}_[0-9]{6}__analysis__(?:comsol|simion|cross|cad|python|repo)__[a-z0-9]+(?:-[a-z0-9]+)*(?:__[a-z0-9]+(?:-[a-z0-9]+)*)*(?:__r[0-9]{2})?$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "project_id",
        "authorized_run_id",
        "solver",
        "stop_stage",
        "design_profile_id",
        "particle_source_profile_id",
        "comsol_solver_numerics_profile_id",
        "simion_solver_numerics",
        "retention_class",
        "resource_authorization",
        "claim_limit"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "authorized_run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "solver": {"const": "simion"},
        "stop_stage": {"const": "transport"},
        "case_set": {"enum": ["primary_only", "primary_and_zero_axial_control", "primary_and_rf_off_energy_control"]},
        "design_profile_id": {"type": "string", "minLength": 1},
        "source_kinetic_energy_eV": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100.0
        },
        "execution_profile_id": {"type": "string", "minLength": 1},
        "design_variable_values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rf_amplitude": {"type": "number"},
            "rf_frequency": {"type": "number"},
            "rf_phase": {"type": "number"},
            "common_mode_offset": {"type": "number"},
            "segment_entrance_common_mode": {"type": "number"},
            "segment_exit_common_mode": {"type": "number"},
            "segment_output_reference": {"type": "number"}
          }
        },
        "particle_source_profile_id": {"type": "string", "minLength": 1},
        "comsol_solver_numerics_profile_id": {"type": "string", "minLength": 1},
        "simion_solver_numerics": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "profile_id"],
              "properties": {
                "kind": {"const": "profile"},
                "profile_id": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "numerics_id", "values"],
              "properties": {
                "kind": {"const": "inline"},
                "numerics_id": {"type": "string", "minLength": 1},
                "values": {"$ref": "#/$defs/simion_numerics"}
              }
            }
          ]
        },
        "simion_dispatch": {"$ref": "#/$defs/simion_dispatch"},
        "retention_class": {
          "enum": ["compact", "qualification", "solver_review"]
        },
        "resource_authorization": {"$ref": "#/$defs/resource_authorization"},
        "claim_limit": {"type": "string", "minLength": 1}
      }
    },
    "simion_numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_mm_xyz",
        "trajectory_quality",
        "trajectory"
      ],
      "properties": {
        "cell_mm_xyz": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "number", "exclusiveMinimum": 0},
            "y": {"type": "number", "exclusiveMinimum": 0},
            "z": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "trajectory_quality": {"type": "integer", "minimum": 0},
        "trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rf_steps_per_period", "maximum_global_time_us"],
          "properties": {
            "rf_steps_per_period": {
              "type": "integer",
              "minimum": 4
            },
            "maximum_global_time_us": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "simion_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field_kind", "independent_particles"],
      "properties": {
        "kind": {"const": "automatic"},
        "field_kind": {"enum": ["rf", "electrostatic"]},
        "independent_particles": {"const": true}
      }
    },
    "resource_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "limits",
        "full_matrix_authorization",
        "budget_exhaustion_result"
      ],
      "properties": {
        "authorized": {"type": "boolean"},
        "limits": {"$ref": "#/$defs/limits"},
        "full_matrix_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorized", "reason"],
          "properties": {
            "authorized": {"const": false},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "budget_exhaustion_result": {"type": "string", "minLength": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_seconds_by_solver",
        "transient_run_directory_bytes",
        "process_tree_working_set_bytes",
        "minimum_system_available_memory_bytes",
        "compact_final_retained_bytes",
        "maximum_pa_grid_points",
        "automatic_retry_count"
      ],
      "properties": {
        "wall_clock_seconds_by_solver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["comsol", "simion"],
          "properties": {
            "comsol": {"type": "integer", "minimum": 1},
            "simion": {"type": "integer", "minimum": 1}
          }
        },
        "transient_run_directory_bytes": {"type": "integer", "minimum": 1},
        "process_tree_working_set_bytes": {"type": "integer", "minimum": 1},
        "minimum_system_available_memory_bytes": {"type": "integer", "minimum": 1},
        "compact_final_retained_bytes": {"type": "integer", "minimum": 1},
        "maximum_pa_grid_points": {"type": "integer", "minimum": 1},
        "automatic_retry_count": {"const": 0}
      }
    }
  }
}
