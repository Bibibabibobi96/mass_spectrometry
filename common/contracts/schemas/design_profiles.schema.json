{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/design_profiles.schema.json",
  "title": "Project design profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "project_id",
    "family_id",
    "profiles"
  ],
  "dependentRequired": {
    "operating_mode_registry": [
      "operating_mode_registry_sha256"
    ],
    "operating_mode_registry_sha256": [
      "operating_mode_registry"
    ]
  },
  "properties": {
    "schema_version": {
      "const": 3
    },
    "role": {
      "const": "project_design_profile_registry"
    },
    "project_id": {
      "$ref": "#/$defs/identifier"
    },
    "family_id": {
      "$ref": "#/$defs/identifier"
    },
    "operating_mode_registry": {
      "$ref": "#/$defs/path"
    },
    "operating_mode_registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "design_profile_id",
          "design_request",
          "design_variables",
          "optimization_envelope",
          "sha256",
          "identity"
        ],
        "properties": {
          "design_profile_id": {
            "$ref": "#/$defs/identifier"
          },
          "mode_id": {
            "$ref": "#/$defs/identifier"
          },
          "design_request": {
            "$ref": "#/$defs/path"
          },
          "design_variables": {
            "$ref": "#/$defs/path"
          },
          "optimization_envelope": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "design_request",
              "design_variables",
              "optimization_envelope"
            ],
            "properties": {
              "design_request": {
                "$ref": "#/$defs/sha256"
              },
              "design_variables": {
                "$ref": "#/$defs/sha256"
              },
              "optimization_envelope": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "required": [
              "project_id",
              "family_id"
            ],
            "properties": {
              "project_id": {
                "$ref": "#/$defs/identifier"
              },
              "family_id": {
                "$ref": "#/$defs/identifier"
              }
            }
          },
          "structural_variant_id": {
            "$ref": "#/$defs/identifier"
          },
          "project_options": {
            "type": "object",
            "description": "Opaque project-owned compilation options; validated by the project resolver."
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}
