{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rf_oatof_resolved_region_field_contract.schema.json",
  "title": "Resolved oaTOF region field contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "layout_geometry", "semantic", "semantic_sha256"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "role": {"const": "rf_oatof_resolved_region_field_contract"},
    "layout_geometry": {
      "type": "object",
      "required": ["sha256", "layout_profile_id", "architecture_generation_id"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "layout_profile_id": {"type": ["string", "null"]},
        "architecture_generation_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "required": ["field_configuration_id", "canonical_profile_id", "region_modes", "planes_mm", "fields_V_per_mm", "effective_domain", "pa_role", "real_pa_field_blending_allowed", "instance_coordinate_mapping"],
      "properties": {
        "field_configuration_id": {"enum": ["REAL_ACCELERATOR_REAL_REFLECTOR_FIELD", "IDEAL_STAGE1_REAL_STAGE2_REAL_REFLECTOR_FIELD", "REAL_STAGE1_IDEAL_STAGE2_REAL_REFLECTOR_FIELD", "IDEAL_ACCELERATOR_REAL_REFLECTOR_FIELD", "FULL_DOMAIN_PIECEWISE_IDEAL_FIELD", "IDEAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD", "REAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD"]},
        "canonical_profile_id": {"type": "string", "minLength": 1},
        "accelerator_topology": {
          "type": "object",
          "required": ["topology_id", "planes_global_z_mm", "potentials_v"],
          "additionalProperties": false,
          "properties": {
            "topology_id": {"const": "three_zone_accelerator_ideal_v1"},
            "planes_global_z_mm": {"$ref": "#/$defs/three_zone_values"},
            "potentials_v": {"$ref": "#/$defs/three_zone_values"}
          }
        },
        "region_modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accelerator_stage1": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "accelerator_stage2": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "accelerator_zone1": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "accelerator_zone2": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "accelerator_zone3": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "drift": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "reflectron_stage1": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]},
            "reflectron_stage2": {"enum": ["real_pa_field", "analytic_ideal_field", "zero_field"]}
          }
        },
        "planes_mm": {"type": "object"},
        "fields_V_per_mm": {"type": "object"},
        "effective_domain": {
          "type": "object",
          "required": ["longitudinal", "transverse", "outside_longitudinal_domain"],
          "properties": {
            "longitudinal": {"enum": ["closed_piecewise_path_repeller_to_reflectron_backplate", "native_pa_instance_domain"]},
            "transverse": {"enum": ["analytic_field_extends_until_native_pa_geometry_collision", "native_pa_instance_domain"]},
            "outside_longitudinal_domain": {"enum": ["invalid_trajectory_error", "native_pa_base_field_unchanged"]}
          },
          "additionalProperties": false
        },
        "pa_role": {"const": "geometry_and_collision_carrier_plus_explicit_real_pa_field_regions"},
        "real_pa_field_blending_allowed": {"const": false},
        "instance_coordinate_mapping": {"type": "object"}
      },
      "additionalProperties": false
    },
    "semantic_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "$defs": {
    "three_zone_values": {
      "type": "object",
      "required": ["repeller", "intermediate1", "intermediate2", "exit"],
      "additionalProperties": false,
      "properties": {
        "repeller": {"type": "number"},
        "intermediate1": {"type": "number"},
        "intermediate2": {"type": "number"},
        "exit": {"type": "number"}
      }
    },
    "three_zone_planes": {
      "type": "object",
      "required": ["repeller", "intermediate1", "intermediate2", "exit", "reflectron_entrance", "reflectron_midgrid", "reflectron_backplate"],
      "additionalProperties": false,
      "properties": {
        "repeller": {"type": "number"},
        "intermediate1": {"type": "number"},
        "intermediate2": {"type": "number"},
        "exit": {"type": "number"},
        "reflectron_entrance": {"type": "number"},
        "reflectron_midgrid": {"type": "number"},
        "reflectron_backplate": {"type": "number"}
      }
    },
    "three_zone_fields": {
      "type": "object",
      "required": ["accelerator_zone1", "accelerator_zone2", "accelerator_zone3", "reflectron_stage1", "reflectron_stage2"],
      "additionalProperties": false,
      "properties": {
        "accelerator_zone1": {"type": "number", "exclusiveMinimum": 0},
        "accelerator_zone2": {"type": "number", "exclusiveMinimum": 0},
        "accelerator_zone3": {"type": "number", "exclusiveMinimum": 0},
        "reflectron_stage1": {"type": "number"},
        "reflectron_stage2": {"type": "number"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"properties": {"semantic": {
        "not": {"required": ["accelerator_topology"]},
        "properties": {
          "field_configuration_id": {"not": {"enum": ["IDEAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD", "REAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD"]}},
          "canonical_profile_id": {"not": {"enum": ["accelerator_ideal_three_zone_real_reflectron", "accelerator_real_three_zone_pa_real_reflectron"]}},
          "region_modes": {"required": ["accelerator_stage1", "accelerator_stage2", "drift", "reflectron_stage1", "reflectron_stage2"], "maxProperties": 5},
          "effective_domain": {
            "properties": {
              "longitudinal": {"const": "closed_piecewise_path_repeller_to_reflectron_backplate"},
              "transverse": {"const": "analytic_field_extends_until_native_pa_geometry_collision"},
              "outside_longitudinal_domain": {"const": "invalid_trajectory_error"}
            }
          }
        }
      }}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"properties": {"semantic": {
        "required": ["accelerator_topology"],
        "properties": {
          "region_modes": {
            "required": ["accelerator_zone1", "accelerator_zone2", "accelerator_zone3", "drift", "reflectron_stage1", "reflectron_stage2"],
            "maxProperties": 6
          },
          "planes_mm": {"$ref": "#/$defs/three_zone_planes"}
        },
        "oneOf": [
          {
            "properties": {
              "field_configuration_id": {"const": "IDEAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD"},
              "canonical_profile_id": {"const": "accelerator_ideal_three_zone_real_reflectron"},
              "region_modes": {
                "properties": {
                  "accelerator_zone1": {"const": "analytic_ideal_field"},
                  "accelerator_zone2": {"const": "analytic_ideal_field"},
                  "accelerator_zone3": {"const": "analytic_ideal_field"},
                  "drift": {"const": "real_pa_field"},
                  "reflectron_stage1": {"const": "real_pa_field"},
                  "reflectron_stage2": {"const": "real_pa_field"}
                }
              },
              "fields_V_per_mm": {"$ref": "#/$defs/three_zone_fields"},
              "effective_domain": {
                "properties": {
                  "longitudinal": {"const": "closed_piecewise_path_repeller_to_reflectron_backplate"},
                  "transverse": {"const": "analytic_field_extends_until_native_pa_geometry_collision"},
                  "outside_longitudinal_domain": {"const": "invalid_trajectory_error"}
                }
              }
            }
          },
          {
            "properties": {
              "field_configuration_id": {"const": "REAL_THREE_ZONE_ACCELERATOR_REAL_REFLECTOR_FIELD"},
              "canonical_profile_id": {"const": "accelerator_real_three_zone_pa_real_reflectron"},
              "region_modes": {
                "properties": {
                  "accelerator_zone1": {"const": "real_pa_field"},
                  "accelerator_zone2": {"const": "real_pa_field"},
                  "accelerator_zone3": {"const": "real_pa_field"},
                  "drift": {"const": "real_pa_field"},
                  "reflectron_stage1": {"const": "real_pa_field"},
                  "reflectron_stage2": {"const": "real_pa_field"}
                }
              },
              "fields_V_per_mm": {"const": {}},
              "effective_domain": {
                "properties": {
                  "longitudinal": {"const": "native_pa_instance_domain"},
                  "transverse": {"const": "native_pa_instance_domain"},
                  "outside_longitudinal_domain": {"const": "native_pa_base_field_unchanged"}
                }
              }
            }
          }
        ]
      }}}
    }
  ]
}
