{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-spectrometry.local/schemas/multipole_downstream_terminal_profiles.schema.json",
  "title": "Governed RF multipole downstream terminal profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "integration_id", "compatible_upstream_family_id", "allowed_upstream_project_ids", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "multipole_downstream_terminal_profile_registry"},
    "integration_id": {"type": "string", "minLength": 1},
    "compatible_upstream_family_id": {"const": "rf_multipole_ion_optics"},
    "allowed_upstream_project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "terminal_profile_id", "owner", "surface_role",
          "rod_end_clearance_mm", "upstream_enclosure_end_plane_binding",
          "electrode_thickness_mm", "outer_envelope", "aperture",
          "terminal_potential_V"
        ],
        "properties": {
          "terminal_profile_id": {"$ref": "#/$defs/identifier"},
          "owner": {"const": "downstream"},
          "surface_role": {"const": "aperture_outer_tangent_plane"},
          "rod_end_clearance_mm": {"type": "number", "exclusiveMinimum": 0},
          "upstream_enclosure_end_plane_binding": {"const": "interfaces_mm.exit.aperture_plate_upstream_face_z_mm"},
          "electrode_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
          "outer_envelope": {
            "type": "object", "additionalProperties": false,
            "required": ["shape", "width_mm", "height_mm"],
            "properties": {
              "shape": {"const": "rectangular"},
              "width_mm": {"type": "number", "exclusiveMinimum": 0},
              "height_mm": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "aperture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shape", "width_mm", "height_mm", "width_axis", "height_axis"],
            "properties": {
              "shape": {"enum": ["rectangular", "circular"]},
              "width_mm": {"type": "number", "exclusiveMinimum": 0},
              "height_mm": {"type": "number", "exclusiveMinimum": 0},
              "width_axis": {"const": "multipole_x"},
              "height_axis": {"const": "multipole_y"}
            }
          },
          "terminal_potential_V": {"type": "number"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"}
  }
}
