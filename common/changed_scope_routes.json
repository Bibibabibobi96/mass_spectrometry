          "regex": "^projects/rf_quadrupole_ion_optics/analysis/(derive_shared_centroid_pulse_time|plot_shared_pulse_geometry_snapshot|audit_pulse_capture_pulse_chain|build_pulse_capture_local_exit_component_state|analyze_analyzer_transport|validate_oatof_formal_analyzer_release)\\.py$",
