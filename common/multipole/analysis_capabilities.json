{
  "schema_version": 1,
  "role": "multipole_campaign_analysis_capability_catalog",
  "capabilities": [
    {
      "capability_id": "multipole_exit_state_comparison_v1",
      "consumer": {
        "analysis_module": "common.multipole.campaign_analysis",
        "plot_module": "common.multipole.exit_state_plot"
      },
      "allowed_projects": [
        "rf_quadrupole_ion_optics",
        "rf_hexapole_ion_optics",
        "rf_octupole_ion_optics"
      ],
      "allowed_solvers": ["simion"],
      "input_roles": {
        "source_run_manifest": "simulation_run_manifest",
        "source_figure_manifest": "multipole_exit_state_figure_manifest",
        "source_state": "canonical_component_particle_state"
      },
      "required_consistency": [
        "campaign_id",
        "solver",
        "stop_stage",
        "case_set",
        "design_profile_id",
        "particle_source_profile_id",
        "comsol_solver_numerics_profile_id",
        "retention_class"
      ],
      "series_count": {"minimum": 2, "maximum": 10},
      "allowed_parameters": {
        "bin_count": {"type": "integer", "minimum": 12, "maximum": 64, "default": 24},
        "dpi": {"type": "integer", "minimum": 180, "maximum": 300, "default": 200}
      },
      "fixed_settings": {
        "title": "RF multipole exit-state comparison",
        "purpose": "Preregistered same-campaign engineering comparison with shared scales and fixed bins"
      },
      "fixed_output_roles": {
        "metrics": "results/metrics.json",
        "report": "results/report.md",
        "figure": "results/figure.png",
        "figure_manifest": "results/figure_manifest.json"
      },
      "claim_class": "UNQUALIFIED_DIAGNOSTIC_ONLY"
    }
  ]
}
