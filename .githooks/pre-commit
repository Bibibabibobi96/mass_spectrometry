#!/bin/sh
set -eu

git diff --cached --check

blocked_files=''
while IFS= read -r path; do
  case "$path" in
    *.mph|official_docs/*.pdf|scan_*.m|tmp_*.m|*/scan_*.m|*/tmp_*.m)
      blocked_files="${blocked_files}${path}
"
      ;;
  esac
done <<EOF
$(git diff --cached --name-only --diff-filter=ACMR)
EOF

if [ -n "$blocked_files" ]; then
  echo "Commit blocked: staged files violate this repository's lifecycle rules:" >&2
  echo "$blocked_files" >&2
  echo "Document one-off work, then remove it; keep models and official PDFs outside Git." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
if [ -x "$repo_root/.venv/Scripts/python.exe" ]; then
  python_exe="$repo_root/.venv/Scripts/python.exe"
elif command -v python >/dev/null 2>&1; then
  python_exe=$(command -v python)
else
  echo "Commit blocked: Python 3.11 runtime is unavailable." >&2
  exit 1
fi
python_version=$("$python_exe" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
if [ "$python_version" != "3.11" ]; then
  echo "Commit blocked: development standards require Python 3.11, found $python_version." >&2
  exit 1
fi
"$python_exe" "$repo_root/common/verify_development_standards.py"
