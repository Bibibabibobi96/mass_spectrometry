# COMSOL binary models are stored outside this source repository.
*.mph

# Official manuals are local reference material, not normal repository history.
official_docs/*.pdf

# Local runtime caches and machine-specific launchers are not source assets.
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.mypy_cache/
.venv/
.tmp/
run_comsol_mcp.cmd

# Editor backups and rejected patch remnants are disposable local files.
*.bak
*.orig
*.rej
*~

# SIMION gem2pa compiler intermediate; reproducible from the tracked GEM source.
*.processed.gem

# SIMION runtime arrays/workbenches are stored in artifacts, not source.
*.pa
*.pa#
*.pa[0-9]*
*.iob
# Version-controlled, GUI-created Workbench containers.  Their distinct
# per-slot placeholder PAs are necessary because SIMION keeps instances that
# share a filename attached to the same PA object.
!common/simion/assets/iob_instance_seeds/
!common/simion/assets/iob_instance_seeds/*.iob
!common/simion/assets/iob_instance_seeds/iob_seed_placeholder_*.pa0
trj*.tmp

# CAD binaries are generated into artifacts/cad.
*.sldprt
*.sldasm
*.step
*.stp

# Runtime logs belong under artifacts/runs.
*.log

# Manifest-derived one-shot exploration campaigns are generated locally from
# immutable run evidence and must not become hand-authored source files.
integrations/rf_multipole_ion_optics_to_single_reflection_oa_tof_mass_analyzer/config/explorations/generated/
