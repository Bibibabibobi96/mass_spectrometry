{
  "schema_version": 1,
  "role": "project_execution_profiles",
  "project_id": "rf_hexapole_ion_optics",
  "profiles": [
    {
      "profile_id": "simion_transport_campaign_engineering",
      "capability_id": "hexapole_finite_3d_transport",
      "mode": "finite_3d_no_collision",
      "evidence_levels": ["plan"],
      "supported_objectives": [
        "transmission_fraction",
        "exit_rms_radius",
        "exit_rms_divergence",
        "exit_energy_spread"
      ],
      "supported_operating_points": [
        {"mass": {"value": 100.0, "unit": "Da"}, "charge_state": 1}
      ],
      "supported_design_variables": ["rf_amplitude", "rf_frequency"],
      "supported_constraints": [
        "locked_multipole_identity",
        "catalog_variable_bounds",
        "campaign_variable_bounds",
        "phase_matched_particle_source",
        "downstream_terminal_geometry"
      ],
      "deliverable_outputs": [
        "simulation_results",
        "simion_model",
        "validation_report",
        "interface_state"
      ],
      "required_bindings": ["campaign_path", "experiment_id"],
      "steps": [
        {
          "step_id": "static_gate",
          "kind": "gate",
          "shell": "powershell",
          "entrypoint": "verify_project.ps1",
          "run_id_template": null,
          "arguments": ["-PythonExe", "{python_exe}"]
        },
        {
          "step_id": "simion_campaign_run",
          "kind": "run",
          "shell": "powershell",
          "entrypoint": "../../common/multipole/run_simion_transport_campaign.ps1",
          "run_id_template": "{authorized_run_id}",
          "arguments": [
            "-CampaignPath", "{campaign_path}",
            "-ExperimentId", "{experiment_id}",
            "-PythonExe", "{python_exe}"
          ]
        }
      ],
      "limitations": [
        "Only explicitly preregistered SIMION engineering rows may run through this profile.",
        "A successful run does not establish numerical convergence, cross-solver equivalence or Candidate maturity."
      ]
    }
  ]
}
