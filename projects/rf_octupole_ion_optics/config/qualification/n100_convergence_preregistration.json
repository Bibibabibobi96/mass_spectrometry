{
  "schema_version": 1,
  "role": "multipole_n100_spatial_time_convergence_preregistration",
  "project_id": "rf_octupole_ion_optics",
  "contract_id": "octupole_three_mode_n100_convergence",
  "preregistered_before_run": true,
  "particle_count": 100,
  "modes": [
    "no_acceleration_full_length",
    "segmented_rod_axial_acceleration",
    "exit_aperture_plate_acceleration"
  ],
  "three_tier_sequence": [
    {
      "tier_id": "baseline",
      "comsol_profile_id": "baseline_finite_3d",
      "simion_profile_id": "baseline_finite_3d"
    },
    {
      "tier_id": "spatial_refined",
      "comsol_profile_id": "n100_spatial_refined",
      "simion_profile_id": "n100_spatial_refined"
    },
    {
      "tier_id": "temporal_refined",
      "comsol_profile_id": "n100_temporal_refined",
      "simion_profile_id": "n100_temporal_refined"
    }
  ],
  "controlled_comparisons": {
    "comsol_spatial": {
      "vary_only": "working_region_maximum_element_size_mm",
      "coarse": 0.5,
      "refined": 0.25,
      "fixed_rf_steps_per_period": 80
    },
    "comsol_time": {
      "vary_only": "rf_steps_per_period",
      "coarse": 80,
      "refined": 160,
      "fixed_working_region_maximum_element_size_mm": 0.25
    },
    "simion_spatial": {
      "vary_only": "cell_mm",
      "coarse": 0.4,
      "refined": 0.2,
      "fixed_rf_steps_per_period": 40
    },
    "simion_time": {
      "vary_only": "rf_steps_per_period",
      "coarse": 40,
      "refined": 80,
      "fixed_cell_mm": 0.2
    }
  },
  "observables": [
    "transmitted_particle_count",
    "handoff_particle_id_set",
    "minimum_aperture_margin",
    "handoff_position_velocity_time_energy"
  ],
  "acceptance_binding": "config/qualification/dispersion_acceptance.json",
  "decision_policy": {
    "with_supported_acceptance_budget": "Evaluate adjacent tiers without changing the preregistered inputs.",
    "without_supported_acceptance_budget": "INCONCLUSIVE",
    "forbidden": "Do not invent a percentage tolerance, relax a failed tolerance, or continue refinement outside the three registered tiers."
  }
}
