{
  "schema_version": 1,
  "role": "project_execution_profiles",
  "project_id": "rf_octupole_ion_optics",
  "profiles": [
    {
      "profile_id": "simion_transport_campaign_engineering",
      "capability_id": "octupole_finite_3d_transport",
      "mode": "finite_3d_no_collision",
      "evidence_levels": ["plan"],
      "supported_objectives": [
        "transmission_fraction",
        "exit_rms_radius",
        "exit_rms_divergence",
        "exit_energy_spread"
      ],
      "supported_operating_points": [
        {"mass": {"value": 100.0, "unit": "Da"}, "charge_state": 1}
      ],
      "supported_design_variables": [
        "inscribed_radius_r0", "rod_radius_ratio", "rod_z_min", "rod_z_max",
        "enclosure_working_region_radius", "vacuum_z_min", "vacuum_z_max",
        "shield_inner_radius", "shield_outer_radius", "entrance_outer_endcap_upstream_face_z",
        "entrance_outer_endcap_downstream_face_z", "exit_outer_endcap_upstream_face_z", "exit_outer_endcap_downstream_face_z",
        "entrance_aperture_radius", "entrance_plate_thickness", "entrance_rod_clearance",
        "entrance_connector_length", "entrance_release_offset",
        "exit_aperture_radius", "exit_plate_thickness", "exit_rod_clearance",
        "exit_connector_length", "exit_census_offset",
        "rf_amplitude", "dc_amplitude", "common_mode_offset", "rf_frequency", "rf_phase",
        "segment_count", "intersegment_gap", "segment_entrance_common_mode",
        "segment_exit_common_mode", "segment_output_reference"
      ],
      "supported_constraints": [
        "locked_multipole_identity",
        "catalog_variable_bounds",
        "campaign_variable_bounds",
        "phase_matched_particle_source",
        "downstream_terminal_geometry"
      ],
      "deliverable_outputs": [
        "simulation_results",
        "simion_model",
        "validation_report",
        "interface_state"
      ],
      "required_bindings": ["campaign_path", "experiment_id"],
      "steps": [
        {
          "step_id": "static_gate",
          "kind": "gate",
          "shell": "powershell",
          "entrypoint": "verify_project.ps1",
          "run_id_template": null,
          "arguments": ["-PythonExe", "{python_exe}"]
        },
        {
          "step_id": "simion_campaign_run",
          "kind": "run",
          "shell": "powershell",
          "entrypoint": "../../common/multipole/run_simion_transport_campaign.ps1",
          "run_id_template": "{authorized_run_id}",
          "arguments": [
            "-CampaignPath", "{campaign_path}",
            "-ExperimentId", "{experiment_id}",
            "-PythonExe", "{python_exe}"
          ]
        }
      ],
      "limitations": [
        "Only explicitly preregistered SIMION engineering rows may run through this profile.",
        "A successful run does not establish numerical convergence, cross-solver equivalence or Candidate maturity."
      ]
    }
  ]
}
