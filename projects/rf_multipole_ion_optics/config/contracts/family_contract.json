    },
    "hexapole": {
      "radial_order_n": 3,
      "electrode_count": 6
    },
    "octupole": {
      "radial_order_n": 4,
      "electrode_count": 8
    }
  },
  "canonical_units": {
    "length": "mm",
    "frequency": "Hz",
    "voltage": "V",
    "phase": "rad",
    "mass_to_charge": "Th"
  }
