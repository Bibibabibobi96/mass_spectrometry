      "accessed_date": "2026-09-08"
    },
    {
      "vendor": "COMSOL",
      "version": "6.4",
      "title": "Outlet - High Mach Number Flow",
      "url": "https://doc.comsol.com/6.4/doc/com.comsol.help.cfd/cfd_ug_fluidflow_high_mach.08.21.html",
